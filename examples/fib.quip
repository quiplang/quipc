@pure @const make std = @import "../library/std/pkg.quip"

@pub @entry
make main () -> int {

    make i = 0
    while i < 10000 {
        fib(20)
        i = i + 1
    }

    fib(20)
    return 0
}

make fib (n: int) -> int {
    if n < 2 {
        return n
    }

    return fib(n - 1) + fib(n - 2)
}
