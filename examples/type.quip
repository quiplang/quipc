@pure @const {
    make std = @import "../library/std/pkg.quip"
}

make type BankAccount {

    @pub {
        make owner_name: str
        make balance: float = 0.0 // default value
    }

    @pub
    make create (o_name: str) -> BankAccount {
        return BankAccount {
            owner_name = o_name,
        }
    }

    @pub @this
    make deposit (amount: float) -> !void {
        if amount < 0.0 {
            return error.InvalidAmount
        }

        this.balance += amount
    }

    @pub @this
    make withdraw (amount: float) -> !void {
        if amount < 0.0 {
            return error.InvalidAmount
        }

        if amount > this.balance {
            return error.InsufficientFunds
        }

        this.balance -= amount
    }

    @pub @this
    make print () -> void {
        std::io::print("Balance for " + this.owner_name)
        std::io::println(" : " + this.balance.to_str())
    }
}

@pub @entry
make main () -> int {
    make account1 = BankAccount.create("John")
    make account2 = BankAccount {
        owner_name = "Kate",
    }

    account2.deposit(100.0) catch { err_neg_val() }

    account1.deposit(70.0) catch { err_neg_val() }
    account1.withdraw(80.0) catch e {
        match e {
            error.InvalidAmount { err_neg_val() }

            error.InsufficientFunds {
                std::io::println("Withdraw failed becuase of insufficient funds")
            }
        }
    }

    account1.print()
    account2.print()

    return 0
}

make err_neg_val () -> void {
    std::io::println("Deposit failed because of negative amount")
}
