@pure @const {
    make mem: unit = @import "../mem/pkg.quip"
}

@impl ptr<char>
make to_str () -> str {

    make result: str = ""
    make i: int = 0

    @unsafe {
        make source: ptr<char> = this.*
        make null: ptr<char> = 0

        if source == null { return result }

        while source[i] != '\0' {
            result = result + source[i]
            i = i + 1
        }
    }

    return result
}


@impl str
make to_c_str () -> ptr<char> {
    make result: ptr<char> = mem::debug.alloc((@sizeof char) * (this.len() + 1)).unwrap()

    make i = 0
    for c : this.* {
        @unsafe result[i] = c
        i++
    }

    result[this.len()] = '\0'

    return result
}

@pub
make strlen (fmt: ref<ptr<char>>) -> int {

    make len: int = 0
    make i: int = 0

    while fmt.deref[i] != '\0' {
        i = i + 1
        len = len + 1
    }

    return len
}
