
@impl str
make split (delimeter: char) -> str[] {

    make result: str[] = []

    make current: str = ""
    make i: int = 0

    while i < this.len() {
        if this[i] == delimeter {
            if current.len() > 0 {
                result.push(current)
                current = ""
            }
        } else {
            current += this[i]
        }

        i += 1
    }

    if current.len() > 0 {
        result.push(current)
    }

    return result
}

@impl str
make starts (s: str) -> bool {
    if s.len() > this.len() { return false }

    make i = 0
    while i < s.len() {
        if this[i] != s[i] { return false }
        i++
    }

    return true
}

@impl str
make ends (s: str) -> bool {
    if s.len() > this.len() { return false }

    make start = this.len() - s.len()
    make i: uint = 0

    while i < s.len() {
        if this[start + i] != s[i] { return false }
        i++
    }

    return true
}


