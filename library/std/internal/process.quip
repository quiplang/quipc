@pure @const {
    @target "macos" make os = @import "../os/macos.quip"
    @target "linux" make os = @import "../os/linux.quip"
}

@pure @const {
    make errno = @import "errno.quip"
}


@unsafe @external @intrinsic "constant_address:quip: exec '%s' failed: %s\n"
make quip_process_error_format () -> ptr<char>

@pub
make type Arguments { make data: ptr<str> make length: uint make capacity: uint }

@unsafe
make process_argv_free (argv: ptr<ptr<char>>, count: uint) -> void {
    make i: uint = 0
    while i < count { quip_heap_free(argv[i]) i = i + 1 }

    quip_heap_free(argv)
}

@unsafe
make process_argv (path: ptr<str>, arguments: ptr<Arguments>) -> ptr<ptr<char>> {
    @unsafe make null: ptr<ptr<char>> = 0
    @unsafe make empty: ptr<Arguments> = 0

    if path.*.length <= 0 { return null }

    make count: uint = 0

    if arguments != empty { count = arguments.*.length }

    if count > 1152921504606846973 { return null }

    @unsafe make argv: ptr<ptr<char>> = quip_heap_alloc((count + 2) * 8)

    if argv == null { return null }

    make i: uint = 0
    while i <= count {
        make item = path

        if i > 0 { item = arguments.*.data + (i - 1) }

        @unsafe make data: ptr<char> = quip_heap_alloc(item.*.length + 1)
        @unsafe make no_bytes: ptr<char> = 0

        if data == no_bytes { process_argv_free(argv, i) return null }

        process_copy(data, item.*.data, item.*.length)
        make length: int = item.*.length
        data[length] = '\0'
        argv[i] = data
        i = i + 1
    }

    @unsafe make terminal: ptr<char> = 0
    argv[count + 1] = terminal
    return argv
}

@unsafe
make process_redirect (source: int, target: int) -> void {
    if source >= 0 && source != target {
        @unsafe make descriptor: i32 = source
        @unsafe make destination: i32 = target

        if os::dup2(descriptor, destination) < 0 { os::_exit(127) }
    }
}
@unsafe
make process_duplicate (source: int) -> int {
    if source < 0 { return -1 }

    @unsafe make descriptor: i32 = source
    make minimum: i32 = 3
    make result = os::fcntl(descriptor, os::F_DUPFD, minimum)

    if result < 0 { os::_exit(127) }

    return result
}
@unsafe
make process_close (source: int) -> void {
    if source > 2 { @unsafe make descriptor: i32 = source os::close(descriptor) }
}

@pub @unsafe @export "quip_spawn_process"
make process_spawn (path: ptr<str>, arguments: ptr<Arguments>, input: int, output: int, errors: int) -> int {
    make argv = process_argv(path, arguments)
    @unsafe make null: ptr<ptr<char>> = 0

    if argv == null { return -1 }

    make pid = os::fork()

    if pid < 0 { process_argv_free(argv, arguments.*.length + 1) return -1 }

    if pid == 0 {
        // Duplicate first so shared descriptors and stdin/stdout swaps cannot
        // invalidate a later redirect. All temporaries are raw OS descriptors.
        make child_input = process_duplicate(input)
        make child_output = process_duplicate(output)
        make child_errors = process_duplicate(errors)
        process_redirect(child_input, 0)
        process_redirect(child_output, 1)
        process_redirect(child_errors, 2)
        process_close(child_input)
        process_close(child_output)
        process_close(child_errors)
        process_close(input)

        if output != input { process_close(output) }

        if errors != input && errors != output { process_close(errors) }

        os::execvp(argv[0], argv)
        make code = errno::get()
        os::dprintf(2, quip_process_error_format(), argv[0], os::strerror(code.*))
        os::_exit(127)
    }

    process_argv_free(argv, arguments.*.length + 1)
    return pid
}

@pub @unsafe @export "quip_wait_process"
make process_wait (pid: int) -> int {
    @unsafe make native_pid: i32 = pid
    make status: i32 = 0
    @unsafe make address: ptr<i32> = status.pin
    make result = os::waitpid(native_pid, address, 0)

    while result < 0 {
        make code = errno::get()

        if code.* != 4 { return -1 }

        result = os::waitpid(native_pid, address, 0)
    }

    @unsafe make value: int = status
    make signal: int = value & 127

    if signal != 0 && signal != 127 { return -signal }

    if signal == 0 { return (value >> 8) & 255 }

    return -1
}

@pub @unsafe @export "quip_run_process"
make process_run (path: ptr<str>, arguments: ptr<Arguments>, input: int, output: int, errors: int) -> int {
    make pid = process_spawn(path, arguments, input, output, errors)

    if pid < 0 { return -1 }

    return process_wait(pid)
}

@pub @unsafe @export "quip_kill_process"
make process_kill (pid: int, signal: int) -> int {
    @unsafe make native_pid: i32 = pid
    @unsafe make native_signal: i32 = signal
    return os::kill(native_pid, native_signal)
}

@unsafe @external make quip_heap_alloc (size: uint) -> ptr<any>
@unsafe @external make quip_heap_free (buffer: ptr<any>) -> void
@unsafe make process_copy (dst: ptr<char>, src: ptr<char>, count: uint) -> void {
    make i: uint = 0
    while i < count { dst[i] = src[i] i = i + 1 }
}
