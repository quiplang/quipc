@pure @const {
    make p: unit = @import "path.quip"
    make os: unit = @import "../os/pkg.quip"
}

/// represents a file on the filesystem
@pub
make type File {

    @pub {
        make path_abs: p::Path = .{}
        make fd: int = -1
        make content: str = ""
    }

    /// opens an existing file
    @pub
    make open (path: variant<p::Path, ref<p::Path>>, mode: str) -> !File {
        make access = os::FileAccess.Read

        match mode {
            "r" { access = os::FileAccess.Read }
            "w" { access = os::FileAccess.Write }
            "rw" { access = os::FileAccess.ReadWrite }
            _ { return error.InvalidMode }
        }

        make filename: str = match path {
            a: p::Path => a.get()
            b: ref<p::Path> => b.*.get()
        }

        for ch : filename ! {
            if ch == '\0' { os::set_errno(os::ErrorCode.Invalid) return error.IOError }
        }
        filename.push('\0')

        make f: File = .{}
        @unsafe f.fd = os::open(filename.data, os::OpenOptions { access = access }) catch { return error.IOError }

        if f.fd < 0 { return error.IOError }

        return f
    }

    /// creates new file
    @pub
    make create (path: variant<p::Path, ref<p::Path>>, mode: int) -> !File {
        make file: File = .{}

        make filename: str = match path {
            a: p::Path => a.get()
            b: ref<p::Path> => b.*.get()
        }

        if mode < 0 || mode > 4095 { return error.InvalidMode }
        for ch : filename ! {
            if ch == '\0' { os::set_errno(os::ErrorCode.Invalid) return error.IOError }
        }
        filename.push('\0')
        @unsafe make permissions: u32 = mode
        @unsafe file.fd = os::open(filename.data, os::OpenOptions {
            access = os::FileAccess.Write,
            create = true,
            truncate = true,
            permissions = permissions,
        }) catch { return error.IOError }

        return file
    }

    /// reads the file content
    @pub @this
    make read () -> !void {

        make info = os::FileInfo {}
        @unsafe os::fstat(this.fd, info.pin) catch { return error.FailedToRead }
        make remaining: int = 0
        if info.kind == os::FileKind.Regular {
            if info.size < 0 { return error.FailedToRead }
            remaining = info.size
        }

        make content: str = ""

        // Keep one extra byte of read space so an unchanged regular file can
        // reach EOF without growing and copying its entire contents first.
        if remaining < 9223372036854775806 { remaining = remaining + 1 }

        content.reserve(remaining) catch { return error.FailedToRead }

        while true {
            make length: int = content.length
            make capacity: int = content.capacity

            if capacity - length <= 1 {
                content.reserve(65536) catch { return error.FailedToRead }
                capacity = content.capacity
            }

            make request: int = capacity - length - 1

            if request > 65536 { request = 65536 }

            @unsafe {
                make data: ptr<char> = content.data
            @unsafe make temp = data + length
                make count: int = os::read(this.fd, temp , request) catch {
                    if os::error_is(os::ErrorCode.Interrupted) { continue }
                    return error.FailedToRead
                }

                if count < 0 { return error.FailedToRead }

                if count == 0 { break }

                content.set_length(length + count) catch { return error.FailedToRead }
            }
        }

        this.content = content
    }

    /// writes passed 'data' to the file
    @pub @this
    make write (data: str) -> !void {

        make offset: uint = 0
        while offset < data.len() {
            @unsafe make count = os::write(this.fd, data.data + offset, data.len() - offset) catch {
                if os::error_is(os::ErrorCode.Interrupted) { continue }
                return error.FailedToWrite
            }
            if count == 0 {
                os::set_errno(os::ErrorCode.Invalid)
                return error.FailedToWrite
            }
            offset = offset + count
        }
    }

    /// closes the file
    @pub @this
    make close () -> void {
        @unsafe os::close(this.fd) catch { return }
    }

    /// opens a file, reads its content and returns it, closes the file
    @pub
    make orc (path: p::Path) -> !str {
        make file: File = File.open(path, "r") catch err { return err }
        file.read() catch err { file.close() return err }
        make result: str = file.content
        file.close()

        return result
    }

}
