@pure @const {

    make os: unit = @import "../os/pkg.quip"

    make mem: unit = @import "../mem/pkg.quip"
    make ffi: unit = @import "../ffi/c.quip"

    make math: unit = @import "../math/pkg.quip"
}

make __path_split (buffer: variant<String, str, ptr<char>>, c: char) -> str[] {
    make s: str = match buffer {
        x: str => x
        y: String => y.to_str()
        z: ptr<char> => z.to_str()
        _ => ""
    }

    make result: str[] = []
    make current: str = ""
    make i: int = 0

    while i < s.len() {
        if s[i] == c {
            if current.len() > 0 {
                result.push(current + "")
                current = ""
            }
        } else {
            current = current + s[i]
        }

        i = i + 1
    }

    if current.len() > 0 {
        result.push(current + "")
    }

    return result
}

@pub
make type Path {

    @pub {
        make content: str[] = []
        make is_absolute: bool = false
    }

    @target "macos" {
        @const make delimeter: char = '/'
    }


    @pub
    make create (buffer: variant<String, str, ptr<char>>) -> Path {
        make path = Path {}

        make text: str = match buffer {
            a: String => a.to_str()
            b: str => b
            c: ptr<char> => c.to_str()
            _ => ""
        }

        if text.len() > 0 {
            path.is_absolute = text[0] == path.delimeter
        }

        path.content = __path_split(text, path.delimeter)

        // resolve '~' (home directory) so it is not passed to the system
        if path.content.len() > 0 {
            if path.content[0] == "~" {

                @unsafe make home_parts = __path_split(os::getenv("HOME"), path.delimeter)
                make resolved: str[] = []

                for p : home_parts.iter() {
                    resolved.push(p !)
                }

                make i: int = 1
                while i < path.content.len() {
                    resolved.push(path.content[i].copy())
                    i = i + 1
                }

                path.content = resolved
                path.is_absolute = true
            }
        }

        return path
    }

    @pub @this
    make get () -> str {
        make path: str = ""

        if this.is_absolute {
            path = path + this.delimeter
        }

        make i: int = 0
        while i < this.content.len() {
            path = path + this.content[i]

            if i < this.content.len() - 1 {
                path = path + this.delimeter
            }

            i = i + 1
        }

        return path
    }

    @pub @this
    make absolute () -> Path {
        if this.is_absolute {
            return Path {
                content = this.content,
                is_absolute = true,
            }
        }

        make cwd = Path.create(os::getcwd())
        make result = Path {}

        for i : cwd.content.iter() {
            result.content.push(i)
        }

        for j : this.content.iter() {
            result.content.push(j)
        }

        return result
    }


    @pub @this
    make copy () -> Path {
        make new: Path = .{}

        for i : this.content.iter() {
            new.content.push(i !)
        }

        new.is_absolute = this.is_absolute

        return new
    }

    @pub @this
    make add (other: variant<str, Path, String>) -> Path {

        make new = this.copy()

        match other {

            a: str {
                new.content.push(a)
            }

            b: String {
                new.content.push(b.to_str())
            }

            c: Path {
                for i : c.content.iter() {
                    new.content.push(i !)
                }
            }
        }

        return new
    }
}

@impl String
make to_path () -> Path {
    return Path.create(this.*)
}

@impl str
make to_path () -> Path {
    return Path.create(this.*)
}
