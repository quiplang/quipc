@import "../impl/str.quip"
@import "../fmt/pkg.quip"
@import "../ffi/cffi.quip"
@import "../mem/pkg.quip"

@pure @const {
    make os: unit = @import "../os/pkg.quip"

    // make ffi: unit = @import "../ffi/c.quip"

    // make math: unit = @import "../math/pkg.quip"
}

@pub
make type Path {

    @pub {
        make content: str[] = []
        make is_absolute: bool = false
    }

    @const make delimeter: char = '/'


    @pub
    make create (buffer: variant<String, str, ptr<char>>) -> Path {
        make path = Path {}

        make text: str = match buffer {
            a: String => a.to_str()
            b: str => b
            c: ptr<char> => c.to_str()
            _ => ""
        }

        if text.len() > 0 {
            path.is_absolute = text[0] == path.delimeter
        }

        path.content = text.split(path.delimeter)

        // resolve '~' (home directory) so it is not passed to the system
        if path.content.len() > 0 {
            if path.content[0] == "~" {

                make home_parts: str[] = []
                @unsafe {
                    make home = os::getenv("HOME".data)
                    make null: ptr<char> = 0
                    if home != null {
                        home_parts = home.to_str().split(path.delimeter)
                    }
                }
                make resolved: str[] = []

                for p : home_parts.iter() {
                    resolved.push(p !)
                }

                make i: int = 1
                while i < path.content.len() {
                    resolved.push(path.content[i].copy())
                    i = i + 1
                }

                path.content = resolved
                path.is_absolute = true
            }
        }

        return path
    }

    @pub @this
    make get () -> str {
        make path: str = ""

        if this.is_absolute {
            path = path + this.delimeter
        }

        make i: int = 0
        while i < this.content.len() {
            path = path + this.content[i]

            if i < this.content.len() - 1 {
                path = path + this.delimeter
            }

            i = i + 1
        }

        return path
    }

    @pub @this
    make absolute () -> Path {
        if this.is_absolute {
            return Path {
                content = this.content,
                is_absolute = true,
            }
        }

        make cwd = Path.cwd() catch { @unsafe os::abort() }
        make result = Path { is_absolute = true }

        for i : cwd.content.iter() {
            result.content.push(i)
        }

        for j : this.content.iter() {
            result.content.push(j)
        }

        return result
    }


    @pub @this
    make copy () -> Path {
        make new: Path = .{}

        for i : this.content.iter() {
            new.content.push(i !)
        }

        new.is_absolute = this.is_absolute

        return new
    }

    @pub @this
    make add (other: variant<str, Path, String>) -> Path {

        make new = this.copy()

        match other {

            a: str {
                new.content.push(a)
            }

            b: String {
                new.content.push(b.to_str())
            }

            c: Path {
                for i : c.content.iter() {
                    new.content.push(i !)
                }
            }
        }

        return new
    }

    @pub
    make cwd () -> !Path {
        make buffer: str = ""
        make capacity: uint = 1024

        while capacity <= 1048576 {
            buffer.reserve(capacity) catch { return error.OSFailed }

            @unsafe make value = os::getcwd_into(buffer.data, capacity) catch err {
                if !os::error_is(os::ErrorCode.Range) { return err }
                capacity = capacity * 2
                continue
            }

            make result: str = ""
            make i: uint = 0
            while value[i] != '\0' { result.push(value[i]) i++ }

            return Path.create(result)
        }

        os::set_errno(os::ErrorCode.Range)
        return error.OSFailed
    }
}

@impl String
make to_path () -> Path {
    return Path.create(this.*)
}

@impl str
make to_path () -> Path {
    return Path.create(this.*)
}
