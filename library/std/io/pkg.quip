@pure @const {

    make mem: unit = @import "../mem/pkg.quip"
    make ffi: unit = @import "../ffi/c.quip"

    make file: unit = @import "./file.quip"
    make path: unit = @import "./path.quip"
    make dir: unit = @import "./dir.quip"

    @target "macos" {
        make os: unit = @import "../os/macos.quip"
    }

    @target "linux" {
        make os: unit = @import "../os/linux.quip"
    }
}

@pub @const @nomangle {
    make STDIN: int = 0
    make STDOUT: int = 1
    make STDERR: int = 2
}

@pub @pure @const {
    make MODE_FILE: int = 420           // rw-r--r-- 0o644
    make MODE_FILE_PRIVATE: int = 384   // rw------- 0o600

    make MODE_DIRECTORY: int = 493 // rwxr-xr-x 0o755
    make MODE_DIRECTORY_PRIVATE: int = 448 // rwx------ 0o700

    make MODE_EVERYONE: int = 511         // rwxrwxrwx 0o777
}

@pub @pure @const {
    make File: Type = file::File
    make Path: Type = path::Path
    make Dir: Type = dir::Dir
}


/// prints text followed by a newline to standard output
@pub
make println (fmt: variant<String, str, ref<str>>) -> void {
    print(fmt)

    make new_line: String = "\n"
    @unsafe os::write(os::STDOUT_FILENO, new_line.data, 1)
}

/// prints text to standard output
@pub
make print (fmt: variant<String, str, ref<str>>) -> void {

    make bad_fmt = "unsupported format Type\n"

    match fmt {

        a: String {
            @unsafe os::write(os::STDOUT_FILENO, a.data, a.length)
        }

        b: str {
            @unsafe os::write(os::STDOUT_FILENO, b.data, b.len())
        }

        c: ref<str> {
            @unsafe os::write(os::STDOUT_FILENO, c.*.data, c.*.len())
        }

        _ {
            @unsafe os::write(os::STDOUT_FILENO, bad_fmt.data, bad_fmt.len())
            return
        }
    }

}

/// read a line of input from the user in stdin
@pub
make input () -> !str {
    return error.Unimplemented
}

@pub
make test () -> !void {

    make path = Path.create("pkg.quip")

    // run the whole pipeline Open->Read->Close
    File.orc(path) catch {
        return error.TestFailed
    }

    // create a directory and a file inside it
    make dir_path = Path.create(".quip_test_dir")
    Dir.mkdir(dir_path.pin, MODE_DIRECTORY) catch {
        return error.TestFailed
    }

    make file_path = Path.create(".quip_test_dir/quip_test_file.txt")
    make file: File = File.create(file_path, MODE_FILE) catch {
        return error.TestFailed
    }

    file.write("quip test content") catch {
        return error.TestFailed
    }

    file.close()

    return
}
