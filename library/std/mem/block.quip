@pub
make type Block {

    @pub {
        // true exactly while the block sits on one of the heap's free lists
        make free: bool = true
        make size: int = 0
        // Allocation sequence, used by explicit arena checkpoints.
        make generation: uint = 0
        // the block that follows this one in memory within its mapped chunk
        make next: ptr<Block>? = none
        make is_prev_free: bool = false

        // links of the heap's per-size free lists (only meaningful while `free`)
        make fnext: ptr<Block>? = none
        make fprev: ptr<Block>? = none
    }

    // cuts the block to `new_size` bytes and turns the rest into a new block right after it
    // (linked as `next`). the caller decides which free list the new block goes on.
    @pub @this
    make split (new_size: int) {
        @unsafe {
            // this + 1 advances past the Block header
            make data : ptr<Block> = this + 1
            // cast to ptr<char> to advance by new_size bytes
            make bytes: ptr<char> = data
            make next: ptr<char> = bytes + new_size

            // new block header address
            make new: ptr<Block> = next

            new.*.free = false
            // the remainder also loses the bytes the new header occupies
            new.*.size = this.size - new_size - (@sizeof Block)
            new.*.next = this.next
            this.size = new_size
            this.next = new
        }
    }
}
