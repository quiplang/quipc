// Direct macOS libc / libSystem bindings, for LP64 arm64 and x86_64.
// Use only with --platform macos. Arguments are raw C pointers and integer widths.
// No Quip allocations are accepted by free(); release only matching libc allocations.
// Opaque FILE/DIR/dirent pointers must not be dereferenced as Quip structures.
// Variadic functions carry @variadic; the declared parameters are the fixed prefix.
@pub @pure @const make c = @import "../ffi/c.quip"

@target "macos" {
@pub
make type timespec {
    make tv_sec: i64 = 0
    make tv_nsec: i64 = 0
}

// Darwin LP64 struct stat storage. Quip scalar fields occupy eight-byte
// slots, so native fields narrower than eight bytes must share opaque slots.
// This is not a general C-compatible struct declaration.
@pub
make type stat_t {
    make _dev_mode_nlink: u64 = 0
    make st_ino: u64 = 0
    make _uid_gid: u64 = 0
    make _rdev_padding: u64 = 0
    make st_atime_sec: i64 = 0
    make st_atime_nsec: i64 = 0
    make st_mtime_sec: i64 = 0
    make st_mtime_nsec: i64 = 0
    make st_ctime_sec: i64 = 0
    make st_ctime_nsec: i64 = 0
    make st_birthtime_sec: i64 = 0
    make st_birthtime_nsec: i64 = 0
    @pub make st_size: i64 = 0
    make st_blocks: i64 = 0
    make _blksize_flags: u64 = 0
    make _gen_lspare: u64 = 0
    make _qspare0: u64 = 0
    make _qspare1: u64 = 0
}

@pub @const {
    make STDIN_FILENO: i32 = 0
    make STDOUT_FILENO: i32 = 1
    make STDERR_FILENO: i32 = 2
    make O_RDONLY: i32 = 0
    make O_WRONLY: i32 = 1
    make O_RDWR: i32 = 2
    make O_NONBLOCK: i32 = 4
    make O_APPEND: i32 = 8
    make O_CREAT: i32 = 512
    make O_TRUNC: i32 = 1024
    make O_EXCL: i32 = 2048
    make O_CLOEXEC: i32 = 16777216
    make F_OK: i32 = 0
    make X_OK: i32 = 1
    make W_OK: i32 = 2
    make R_OK: i32 = 4
    make SEEK_SET: i32 = 0
    make SEEK_CUR: i32 = 1
    make SEEK_END: i32 = 2
    make AT_FDCWD: i32 = -2
    make AT_REMOVEDIR: i32 = 128
    make PROT_NONE: i32 = 0
    make PROT_READ: i32 = 1
    make PROT_WRITE: i32 = 2
    make PROT_EXEC: i32 = 4
    make MAP_SHARED: i32 = 1
    make MAP_PRIVATE: i32 = 2
    make MAP_FIXED: i32 = 16
    make MAP_ANON: i32 = 4096
    make MS_SYNC: i32 = 16
    make CLOCK_REALTIME: u32 = 0
    make CLOCK_MONOTONIC: u32 = 6
    make CLOCK_PROCESS_CPUTIME_ID: u32 = 12
    make CLOCK_THREAD_CPUTIME_ID: u32 = 16
    make WNOHANG: i32 = 1
    make EINTR: i32 = 4
    make ENOENT: i32 = 2
    make EACCES: i32 = 13
    make EEXIST: i32 = 17
    make EINVAL: i32 = 22
    make ERANGE: i32 = 34
    make EOVERFLOW: i32 = 84
    make F_GETFD: i32 = 1
    make F_DUPFD: i32 = 0
    make F_SETFD: i32 = 2
    make F_GETFL: i32 = 3
    make F_SETFL: i32 = 4
    make LOCK_SH: i32 = 1
    make LOCK_EX: i32 = 2
    make LOCK_NB: i32 = 4
    make LOCK_UN: i32 = 8
    make PATH_MAX: u32 = 1024
}

@unsafe {
    // Files and descriptors (<unistd.h>, <fcntl.h>, <sys/stat.h>)
    @pub @external @variadic
    make open (path: ptr<char>, flags: i32) -> i32

    @pub @external
    make fstat (fd: i32, stat: ptr<any>) -> i32

    @pub @external @variadic
    make openat (directory: i32, path: ptr<char>, flags: i32) -> i32

    @pub @external
    make creat (path: ptr<char>, mode: u16) -> i32

    @pub @external @variadic
    make fcntl (fd: i32, command: i32) -> i32

    @pub @external
    make close (fd: i32) -> i32

    @pub @external
    make read (fd: i32, buffer: ptr<any>, count: u64) -> i64

    @pub @external
    make write (fd: i32, buffer: ptr<any>, count: u64) -> i64

    @pub @external
    make pread (fd: i32, buffer: ptr<any>, count: u64, offset: i64) -> i64

    @pub @external
    make pwrite (fd: i32, buffer: ptr<any>, count: u64, offset: i64) -> i64

    @pub @external
    make lseek (fd: i32, offset: i64, whence: i32) -> i64

    @pub @external
    make dup (fd: i32) -> i32

    @pub @external
    make dup2 (oldfd: i32, newfd: i32) -> i32

    @pub @external
    make pipe (fds: ptr<i32>) -> i32

    @pub @external
    make fsync (fd: i32) -> i32

    @pub @external
    make flock (fd: i32, operation: i32) -> i32

    @pub @external
    make isatty (fd: i32) -> i32

    @pub @external
    make ttyname (fd: i32) -> ptr<char>

    @pub @external
    make access (path: ptr<char>, mode: i32) -> i32

    @pub @external
    make faccessat (directory: i32, path: ptr<char>, mode: i32, flags: i32) -> i32

    @pub @external
    make mkdir (path: ptr<char>, mode: u16) -> i32

    @pub @external
    make mkdirat (directory: i32, path: ptr<char>, mode: u16) -> i32

    @pub @external
    make rmdir (path: ptr<char>) -> i32

    @pub @external
    make unlink (path: ptr<char>) -> i32

    @pub @external
    make unlinkat (directory: i32, path: ptr<char>, flags: i32) -> i32

    @pub @external
    make rename (oldpath: ptr<char>, newpath: ptr<char>) -> i32

    @pub @external
    make renameat (old_directory: i32, oldpath: ptr<char>, new_directory: i32, newpath: ptr<char>) -> i32

    @pub @external
    make link (oldpath: ptr<char>, newpath: ptr<char>) -> i32

    @pub @external
    make symlink (target: ptr<char>, path: ptr<char>) -> i32

    @pub @external
    make readlink (path: ptr<char>, buffer: ptr<char>, size: u64) -> i64

    @pub @external
    make truncate (path: ptr<char>, length: i64) -> i32

    @pub @external
    make ftruncate (fd: i32, length: i64) -> i32

    @pub @external
    make chmod (path: ptr<char>, mode: u16) -> i32

    @pub @external
    make fchmod (fd: i32, mode: u16) -> i32

    @pub @external
    make umask (mask: u16) -> u16

    @pub @external
    make chown (path: ptr<char>, owner: u32, group: u32) -> i32

    @pub @external
    make fchown (fd: i32, owner: u32, group: u32) -> i32

    @pub @external
    make chdir (path: ptr<char>) -> i32

    @pub @external
    make fchdir (fd: i32) -> i32

    @pub @external
    make getcwd (buffer: ptr<char>, size: u64) -> ptr<char>

    @pub @external
    make realpath (path: ptr<char>, resolved: ptr<char>) -> ptr<char>

    @pub @external
    make mkdtemp (template: ptr<char>) -> ptr<char>

    @pub @external
    make mkstemp (template: ptr<char>) -> i32

    // Directory streams (<dirent.h>); DIR and struct dirent remain opaque
    @pub @external
    make opendir (path: ptr<char>) -> ptr<any>

    @pub @external
    make fdopendir (fd: i32) -> ptr<any>

    @pub @external
    make readdir (directory: ptr<any>) -> ptr<any>

    @pub @external
    make closedir (directory: ptr<any>) -> i32

    @pub @external
    make rewinddir (directory: ptr<any>) -> void

    @pub @external
    make dirfd (directory: ptr<any>) -> i32

    @pub @external
    make telldir (directory: ptr<any>) -> i64

    @pub @external
    make seekdir (directory: ptr<any>, location: i64) -> void

    @pub @external make _NSGetExecutablePath (buffer: ptr<char>, size: ptr<u32>) -> i32

    // Environment and allocation (<stdlib.h>)
    @pub @external
    make getenv (name: ptr<char>) -> ptr<char>

    @pub @external
    make setenv (name: ptr<char>, value: ptr<char>, overwrite: i32) -> i32

    @pub @external
    make unsetenv (name: ptr<char>) -> i32

    @pub @external
    make putenv (assignment: ptr<char>) -> i32

    @pub @external
    make malloc (size: u64) -> ptr<any>

    @pub @external
    make calloc (count: u64, size: u64) -> ptr<any>

    @pub @external
    make realloc (memory: ptr<any>, size: u64) -> ptr<any>

    @pub @external
    make free (memory: ptr<any>) -> void

    @pub @external
    make posix_memalign (memory: ptr<ptr<any>>, alignment: u64, size: u64) -> i32

    @pub @external
    make aligned_alloc (alignment: u64, size: u64) -> ptr<any>

    @pub @external
    make getpagesize () -> i32

    // Memory mappings (<sys/mman.h>)
    @pub @external
    make mmap (address: ptr<any>, length: u64, protection: i32, flags: i32, fd: i32, offset: i64) -> ptr<any>

    @pub @external
    make munmap (address: ptr<any>, length: u64) -> i32

    @pub @external
    make mprotect (address: ptr<any>, length: u64, protection: i32) -> i32

    @pub @external
    make msync (address: ptr<any>, length: u64, flags: i32) -> i32

    @pub @external
    make madvise (address: ptr<any>, length: u64, advice: i32) -> i32

    @pub @external
    make mlock (address: ptr<any>, length: u64) -> i32

    @pub @external
    make munlock (address: ptr<any>, length: u64) -> i32


    // Bytes, C strings and numbers (<string.h>, <stdlib.h>)
    @pub @external
    make memcpy (destination: ptr<any>, source: ptr<any>, count: u64) -> ptr<any>

    @pub @external
    make memmove (destination: ptr<any>, source: ptr<any>, count: u64) -> ptr<any>

    @pub @external
    make memset (destination: ptr<any>, value: i32, count: u64) -> ptr<any>

    @pub @external
    make memcmp (left: ptr<any>, right: ptr<any>, count: u64) -> i32

    @pub @external
    make memchr (memory: ptr<any>, value: i32, count: u64) -> ptr<any>

    @pub @external
    make strlen (text: ptr<char>) -> u64

    @pub @external
    make strnlen (text: ptr<char>, maximum: u64) -> u64

    @pub @external
    make strcmp (left: ptr<char>, right: ptr<char>) -> i32

    @pub @external
    make strncmp (left: ptr<char>, right: ptr<char>, count: u64) -> i32

    @pub @external
    make strcpy (destination: ptr<char>, source: ptr<char>) -> ptr<char>

    @pub @external
    make strncpy (destination: ptr<char>, source: ptr<char>, count: u64) -> ptr<char>

    @pub @external
    make strlcpy (destination: ptr<char>, source: ptr<char>, size: u64) -> u64

    @pub @external
    make strlcat (destination: ptr<char>, source: ptr<char>, size: u64) -> u64

    @pub @external
    make strchr (text: ptr<char>, value: i32) -> ptr<char>

    @pub @external
    make strrchr (text: ptr<char>, value: i32) -> ptr<char>

    @pub @external
    make strstr (text: ptr<char>, needle: ptr<char>) -> ptr<char>

    @pub @external
    make strdup (text: ptr<char>) -> ptr<char>

    @pub @external
    make strndup (text: ptr<char>, count: u64) -> ptr<char>

    @pub @external
    make strtol (text: ptr<char>, end: ptr<ptr<char>>, base: i32) -> i64

    @pub @external
    make strtoul (text: ptr<char>, end: ptr<ptr<char>>, base: i32) -> u64

    @pub @external
    make strtoll (text: ptr<char>, end: ptr<ptr<char>>, base: i32) -> i64

    @pub @external
    make strtoull (text: ptr<char>, end: ptr<ptr<char>>, base: i32) -> u64

    @pub @external
    make strtod (text: ptr<char>, end: ptr<ptr<char>>) -> f64

    @pub @external
    make strtof (text: ptr<char>, end: ptr<ptr<char>>) -> f32

    // Processes and identities (<unistd.h>, <sys/wait.h>, <signal.h>)
    @pub @external
    make getpid () -> i32

    @pub @external
    make getppid () -> i32

    @pub @external
    make getuid () -> u32

    @pub @external
    make geteuid () -> u32

    @pub @external
    make getgid () -> u32

    @pub @external
    make getegid () -> u32

    @pub @external
    make setuid (uid: u32) -> i32

    @pub @external
    make setgid (gid: u32) -> i32

    @pub @external
    make fork () -> i32

    @pub @external
    make execve (path: ptr<char>, argv: ptr<ptr<char>>, envp: ptr<ptr<char>>) -> i32

    @pub @external
    make execv (path: ptr<char>, argv: ptr<ptr<char>>) -> i32

    @pub @external
    make execvp (file: ptr<char>, argv: ptr<ptr<char>>) -> i32

    @pub @external
    make wait (status: ptr<i32>) -> i32

    @pub @external
    make waitpid (pid: i32, status: ptr<i32>, options: i32) -> i32

    @pub @external
    make kill (pid: i32, signal: i32) -> i32

    @pub @external
    make sleep (seconds: u32) -> u32

    @pub @external
    make usleep (microseconds: u32) -> i32

    @pub @external
    make _exit (status: i32) -> void

    @pub @external
    make exit (status: i32) -> void

    @pub @external
    make abort () -> void

    @pub @external
    make system (command: ptr<char>) -> i32

    // Time (<time.h>); timespec contains two signed 64-bit fields on macOS LP64
    @pub @external
    make time (result: ptr<i64>) -> i64

    @pub @external
    make clock () -> u64

    @pub @external
    make clock_gettime (clock_id: u32, result: ptr<timespec>) -> i32

    @pub @external
    make clock_getres (clock_id: u32, result: ptr<timespec>) -> i32

    @pub @external
    make nanosleep (requested: ptr<timespec>, remaining: ptr<timespec>) -> i32

    // Errors (<errno.h>, <string.h>, <stdio.h>)
    @pub @external
    make __error () -> ptr<i32>

    @pub @external
    make strerror (code: i32) -> ptr<char>

    @pub @external
    make perror (prefix: ptr<char>) -> void

    // C buffered streams (<stdio.h>); FILE is opaque; no Quip str crosses this ABI
    @pub @external
    make fopen (path: ptr<char>, mode: ptr<char>) -> ptr<any>

    @pub @external
    make fdopen (fd: i32, mode: ptr<char>) -> ptr<any>

    @pub @external
    make freopen (path: ptr<char>, mode: ptr<char>, stream: ptr<any>) -> ptr<any>

    @pub @external
    make fclose (stream: ptr<any>) -> i32

    @pub @external
    make fflush (stream: ptr<any>) -> i32

    @pub @external
    make fread (buffer: ptr<any>, size: u64, count: u64, stream: ptr<any>) -> u64

    @pub @external
    make fwrite (buffer: ptr<any>, size: u64, count: u64, stream: ptr<any>) -> u64

    @pub @external
    make fseek (stream: ptr<any>, offset: i64, whence: i32) -> i32

    @pub @external
    make ftell (stream: ptr<any>) -> i64

    @pub @external
    make rewind (stream: ptr<any>) -> void

    @pub @external
    make feof (stream: ptr<any>) -> i32

    @pub @external
    make ferror (stream: ptr<any>) -> i32

    @pub @external
    make clearerr (stream: ptr<any>) -> void

    @pub @external
    make fileno (stream: ptr<any>) -> i32

    @pub @external
    make fgetc (stream: ptr<any>) -> i32

    @pub @external
    make fputc (value: i32, stream: ptr<any>) -> i32

    @pub @external
    make fgets (buffer: ptr<char>, size: i32, stream: ptr<any>) -> ptr<char>

    @pub @external
    make fputs (text: ptr<char>, stream: ptr<any>) -> i32

    @pub @external
    make puts (text: ptr<char>) -> i32

    @pub @external
    make remove (path: ptr<char>) -> i32

    @pub @external @variadic
    make printf (format: ptr<char>) -> i32

    @pub @external @variadic
    make dprintf (fd: i32, format: ptr<char>) -> i32

    @pub @external @variadic
    make fprintf (stream: ptr<any>, format: ptr<char>) -> i32

    @pub @external @variadic
    make snprintf (buffer: ptr<char>, size: u64, format: ptr<char>) -> i32

    // errno is thread-local on Darwin; __error returns this thread's storage.
    @pub
    make errno () -> i32 {
        @unsafe {
            make code = __error()
            return code.*
        }
    }

    }

    @pub @pure @const make nfds_t: Type = u32
    @pub @const {
        make SIG_BLOCK: i32 = 1
        make SIG_SETMASK: i32 = 3
        make SIGTSTP: i32 = 18
        make TIOCGWINSZ: u64 = 1074295912
        make FD_CLOEXEC: i32 = 1
    }

    @pub @unsafe @external make sigemptyset (mask: ptr<any>) -> i32

    @pub @unsafe @external make sigaddset (mask: ptr<any>, signal: i32) -> i32

    @pub @unsafe @external make sigprocmask (operation: i32, mask: ptr<any>, previous: ptr<any>) -> i32

    @pub @unsafe @external make sigaction (signal: i32, action: ptr<any>, previous: ptr<any>) -> i32

    @pub @unsafe @external make signal (signal: i32, handler: ptr<any>) -> ptr<any>

    @pub @unsafe @external make raise (signal: i32) -> i32

    @pub @unsafe @external make atexit (callback: ptr<any>)
    -> i32
    @pub @unsafe @external @variadic make ioctl (fd: i32, request: u64) -> i32

    @pub @unsafe @external make poll (fds: ptr<any>, count: nfds_t, timeout: i32) -> i32

}
