@pub @unsafe
make nanosleep (requested: ptr<TimeSpec>, remaining: ptr<TimeSpec>) -> !void {
    @unsafe make null: ptr<TimeSpec> = 0
    if requested == null { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    if requested.*.seconds < 0 || requested.*.nanoseconds < 0 || requested.*.nanoseconds >= 1000000000 { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    make input: native::timespec = .{}
    input.tv_sec = requested.*.seconds
    input.tv_nsec = requested.*.nanoseconds
    make rest: native::timespec = .{}
    make result: i32 = 0
    @target "macos" { result = native::nanosleep(input.pin, rest.pin) }
    @target "linux" { result = native::nanosleep(input.pin, rest.pin) }
    if result < 0 && error_is(ErrorCode.Interrupted) && remaining != null {
        remaining.*.seconds = rest.tv_sec
        remaining.*.nanoseconds = rest.tv_nsec
    }
    if result < 0 { return error.OSFailed }
    return
}

