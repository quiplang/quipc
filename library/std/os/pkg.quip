make type FileInfo {
    @pub {
        make kind: FileKind = FileKind.Unknown
        make permissions: u32 = 0
        make device: u64 = 0
        make inode: u64 = 0
        make links: u64 = 0
        make owner: u32 = 0
        make group: u32 = 0
        make size: i64 = 0
        make blocks: i64 = 0
        make block_size: i64 = 0
        make accessed: TimeSpec = .{}
        make modified: TimeSpec = .{}
        make changed: TimeSpec = .{}
    }
}

@pub
make type MapOptions {
    @pub {
        make kind: MapKind = MapKind.Anonymous
        make sharing: MapSharing = MapSharing.Private
        make protection: Protection = Protection.ReadWrite
        make fixed: bool = false
    }
}

@pub
make type PollEvents {
    @pub {
        make readable: bool = false
        make priority: bool = false
        make writable: bool = false
        make failed: bool = false
        make hangup: bool = false
        make invalid: bool = false
    }
}

@impl PollEvents
make translate () -> u16 {
    make flags: u16 = 0
    if this.readable { flags = flags | 1 }
    if this.priority { flags = flags | 2 }
    if this.writable { flags = flags | 4 }
    if this.failed { flags = flags | 8 }
    if this.hangup { flags = flags | 16 }
    if this.invalid { flags = flags | 32 }
    return flags
}
make poll_events (flags: u16) -> PollEvents {
    return PollEvents {
        readable = (flags & 1) != 0,
        priority = (flags & 2) != 0,
        writable = (flags & 4) != 0,
        failed = (flags & 8) != 0,
        hangup = (flags & 16) != 0,
        invalid = (flags & 32) != 0,
    }
}

@pub
make type PollFd {
    @pub {
        make fd: i32 = -1
        make events: PollEvents = .{}
        make returned: PollEvents = .{}
    }
}

@pub
make type Pipe {
    @pub {
        make read: i32 = -1
        make write: i32 = -1
    }
}

@pub
make type TerminalSize {
    @pub {
        make rows: uint = 0
        make columns: uint = 0
        make width_pixels: uint = 0
        make height_pixels: uint = 0
    }
}

@pub @unsafe
make errno_address () -> ptr<i32> {
    @target "macos" { return native::__error() }
    @target "linux" { return native::__errno_location() }
}

@pub
make errno () -> i32 {
    @unsafe make code = errno_address()
    @unsafe return code.*
}

@pub
make error_is (kind: ErrorCode) -> bool { return errno() == kind.translate() }

@pub
make set_errno (kind: ErrorCode) -> void {
    @unsafe { make code = errno_address() code.* = kind.translate() }
}

@pub @unsafe
make open (path: ptr<char>, options: OpenOptions) -> !i32 {
    if options.permissions > 4095 { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    make flags = options.translate()
    @target "macos" {
        make native_result = native::open(path, flags, options.permissions)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
    @target "linux" {
        make native_result = native::open(path, flags, options.permissions)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
}

@pub @unsafe
make openat (directory: Directory, path: ptr<char>, options: OpenOptions) -> !i32 {
    if options.permissions > 4095 { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    make flags = options.translate()
    make base = directory.translate()
    @target "macos" {
        make native_result = native::openat(base, path, flags, options.permissions)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
    @target "linux" {
        make native_result = native::openat(base, path, flags, options.permissions)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
}

@pub @unsafe
make creat (path: ptr<char>, permissions: u32) -> !i32 {
    return open(path, OpenOptions { access = FileAccess.Write, create = true, truncate = true, permissions = permissions })
}

@pub @unsafe
make lseek (fd: i32, offset: i64, from: SeekFrom) -> !i64 {
    make whence = from.translate()
    @target "macos" {
        make native_result = native::lseek(fd, offset, whence)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
    @target "linux" {
        make native_result = native::lseek(fd, offset, whence)
        if native_result < 0 { return error.OSFailed }
        return native_result
    }
}

@pub @unsafe
make fseek (stream: ptr<any>, offset: i64, from: SeekFrom) -> !void {
    make whence = from.translate()
    @target "macos" {
        make native_result = native::fseek(stream, offset, whence)
        if native_result != 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::fseek(stream, offset, whence)
        if native_result != 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make access (path: ptr<char>, mode: AccessMode) -> !void {
    make flags = mode.translate()
    @target "macos" {
        make native_result = native::access(path, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::access(path, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

