/// Full mapping interface: file/anonymous, private/shared, protections and fixed address.
@pub @unsafe
make map (address: ptr<any>, size: int, options: MapOptions, fd: i32, offset: i64) -> !ptr<any> {
    @unsafe make null: ptr<any> = 0
    if size <= 0 || offset < 0 { set_errno(ErrorCode.Invalid) return error.MappingFailed }
    make flags = options.kind.translate() | options.sharing.translate()
    if options.fixed { flags = flags | 16 }
    make protection = options.protection.translate()
    make descriptor = fd
    if options.kind == MapKind.Anonymous { descriptor = -1 }
    make mapped = null
    @target "macos" { mapped = native::mmap(address, size, protection, flags, descriptor, offset) }
    @target "linux" { mapped = native::mmap(address, size, protection, flags, descriptor, offset) }
    @unsafe make failed: ptr<any> = -1
    if mapped == failed { return error.MappingFailed }
    return mapped
}

