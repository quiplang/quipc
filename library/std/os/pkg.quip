@pub
make type DirectoryEntry {
    @pub {
        make inode: u64 = 0
        make position: i64 = 0
        make kind: FileKind = FileKind.Unknown
        make name: str = ""
    }
}

/// Reads an owned, normalized directory entry: 1 = entry, 0 = EOF; failures return an error.
/// Native dirent storage is copied before the next call can invalidate it.
@pub @unsafe
make readdir (directory: ptr<any>, output: ptr<DirectoryEntry>) -> !i32 {
    make code = errno_address()
    code.* = 0
    @unsafe make null: ptr<any> = 0
    make entry = null
    @target "macos" { entry = native::readdir(directory) }
    @target "linux" { entry = native::readdir(directory) }
    if entry == null {
        if errno() != 0 { return error.OSFailed }
        return 0
    }
    @unsafe make words: ptr<u64> = entry
    @unsafe make lengths: ptr<u16> = entry
    @unsafe make bytes: ptr<char> = entry
    make record_size: uint = lengths[8]
    make name_offset: uint = 0
    make kind: uint = 0
    @target "macos" { name_offset = 21 @unsafe make native_kind: uint = bytes[20] kind = native_kind }
    @target "linux" { name_offset = 19 @unsafe make native_kind: uint = bytes[18] kind = native_kind }
    if record_size <= name_offset { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    make info: DirectoryEntry = .{}
    info.inode = words[0]
    @unsafe info.position = words[1]
    match kind {
        8 { info.kind = FileKind.Regular }
        4 { info.kind = FileKind.Directory }
        10 { info.kind = FileKind.Symlink }
        6 { info.kind = FileKind.BlockDevice }
        2 { info.kind = FileKind.CharacterDevice }
        1 { info.kind = FileKind.Fifo }
        12 { info.kind = FileKind.Socket }
        _ {}
    }
    make i = name_offset
    while i < record_size && bytes[i] != '\0' {
        info.name.push(bytes[i])
        i = i + 1
    }
    if i == record_size { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    output.* = info
    return 1
}

