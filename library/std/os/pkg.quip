            ErrorCode.Range => 34
            ErrorCode.Overflow => 84
            ErrorCode.NotSupported => 45
            ErrorCode.OutOfMemory => 12
            ErrorCode.WouldBlock => 35
            _ => -1
        }
    }
    @target "linux" {
