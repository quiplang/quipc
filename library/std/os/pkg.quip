@pub @unsafe
make raise (signal: Signal) -> !void {
    make flags = signal.translate()
    @target "macos" {
        make native_result = native::raise(flags)
        if native_result != 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::raise(flags)
        if native_result != 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make signal (signal: Signal, handler: ptr<any>) -> !ptr<any> {
    make flags = signal.translate()
    @target "macos" {
        @unsafe make failed: ptr<any> = -1
        make native_result = native::signal(flags, handler)
        if native_result == failed { return error.OSFailed }
        return native_result
    }
    @target "linux" {
        @unsafe make failed: ptr<any> = -1
        make native_result = native::signal(flags, handler)
        if native_result == failed { return error.OSFailed }
        return native_result
    }
}

@pub @unsafe
make mprotect (address: ptr<any>, length: u64, protection: Protection) -> !void {
    make flags = protection.translate()
    @target "macos" {
        make native_result = native::mprotect(address, length, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::mprotect(address, length, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make madvise (address: ptr<any>, length: u64, advice: MemoryAdvice) -> !void {
    make flags = advice.translate()
    @target "macos" {
        make native_result = native::madvise(address, length, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::madvise(address, length, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make faccessat (directory: Directory, path: ptr<char>, mode: AccessMode, effective_ids: bool, follow_symlinks: bool) -> !void {
    make base = directory.translate()
    make access_mode = mode.translate()
    make flags: i32 = 0
    @target "macos" {
        if effective_ids { flags = flags | 16 }
        if !follow_symlinks { flags = flags | 32 }
        make native_result = native::faccessat(base, path, access_mode, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        if effective_ids { flags = flags | 512 }
        if !follow_symlinks { flags = flags | 256 }
        make native_result = native::faccessat(base, path, access_mode, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make unlinkat (directory: Directory, path: ptr<char>, remove_directory: bool) -> !void {
    make base = directory.translate()
    make flags: i32 = 0
    @target "macos" {
        if remove_directory { flags = 128 }
        make native_result = native::unlinkat(base, path, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        if remove_directory { flags = 512 }
        make native_result = native::unlinkat(base, path, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make renameat (old_directory: Directory, oldpath: ptr<char>, new_directory: Directory, newpath: ptr<char>) -> !void {
    make old_base = old_directory.translate()
    make new_base = new_directory.translate()
    @target "macos" {
        make native_result = native::renameat(old_base, oldpath, new_base, newpath)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::renameat(old_base, oldpath, new_base, newpath)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make flock (fd: i32, kind: LockKind, nonblocking: bool) -> !void {
    make flags = kind.translate()
    if nonblocking { flags = flags | 4 }
    @target "macos" {
        make native_result = native::flock(fd, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::flock(fd, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make close_on_exec (fd: i32, enabled: bool) -> !void {
    make flags: i32 = 0
    @target "macos" { flags = native::fcntl(fd, 1) }
    @target "linux" { flags = native::fcntl(fd, 1) }
    if flags < 0 { return error.OSFailed }
    flags = flags & -2
    if enabled { flags = flags | 1 }
    @target "macos" {
        make native_result = native::fcntl(fd, 2, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::fcntl(fd, 2, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make is_close_on_exec (fd: i32) -> !bool {
    make flags: i32 = 0
    @target "macos" { flags = native::fcntl(fd, 1) }
    @target "linux" { flags = native::fcntl(fd, 1) }
    if flags < 0 { return error.DescriptorFailed }
    return (flags & 1) != 0
}

// Only mutable status flags are changed, preserving all other native flags.
@pub @unsafe
make set_status (fd: i32, append: bool, nonblocking: bool) -> !void {
    @target "macos" {
        make flags = native::fcntl(fd, 3)
        if flags < 0 { return error.OSFailed }
        flags = flags & -13
        if append { flags = flags | 8 }
        if nonblocking { flags = flags | 4 }
        make native_result = native::fcntl(fd, 4, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make flags = native::fcntl(fd, 3)
        if flags < 0 { return error.OSFailed }
        flags = flags & -3073
        if append { flags = flags | 1024 }
        if nonblocking { flags = flags | 2048 }
        make native_result = native::fcntl(fd, 4, flags)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make open_options (fd: i32) -> !OpenOptions {
    make flags: i32 = 0
    @target "macos" { flags = native::fcntl(fd, 3) }
    @target "linux" { flags = native::fcntl(fd, 3) }
    if flags < 0 { return error.DescriptorFailed }
    make options: OpenOptions = .{}
    match flags & 3 {
        0 { options.access = FileAccess.Read }
        1 { options.access = FileAccess.Write }
        2 { options.access = FileAccess.ReadWrite }
        _ { return error.DescriptorFailed }
    }
    @target "macos" { options.append = (flags & 8) != 0 options.nonblocking = (flags & 4) != 0 }
    @target "linux" { options.append = (flags & 1024) != 0 options.nonblocking = (flags & 2048) != 0 }
    options.close_on_exec = is_close_on_exec(fd) catch err { return err }
    return options
}

