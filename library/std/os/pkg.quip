@pub @unsafe
make terminal_size (fd: i32) -> !TerminalSize {
    make packed: u64 = 0
    @unsafe make address: ptr<any> = packed.pin
    make result: i32 = 0
    @target "macos" { result = native::ioctl(fd, 1074295912, address) }
    @target "linux" { result = native::ioctl(fd, 21523, address) }
    if result < 0 { return error.TerminalFailed }
    return TerminalSize {
        rows = packed & 65535,
        columns = (packed >> 16) & 65535,
        width_pixels = (packed >> 32) & 65535,
        height_pixels = (packed >> 48) & 65535,
    }
}

// pollfd is packed as i32 + i16 + i16; Quip fields are not native C fields.
@pub @unsafe
make poll (fds: ptr<PollFd>, count: uint, timeout: i32) -> !i32 {
    if count > 2147483647 { set_errno(ErrorCode.Invalid) return error.InvalidArgument }
    make storage = calloc(count + 1, 8) catch err { return err }
    @unsafe make descriptors: ptr<i32> = storage
    @unsafe make events: ptr<u16> = storage
    make i: uint = 0
    while i < count {
        descriptors[i * 2] = fds[i].fd
        events[i * 4 + 2] = fds[i].events.translate()
        i = i + 1
    }
    make result: i32 = 0
    @target "macos" {
        @unsafe make native_count: u32 = count
        result = native::poll(storage, native_count, timeout)
    }
    @target "linux" { result = native::poll(storage, count, timeout) }
    make saved_errno = errno()
    if result >= 0 {
        i = 0
        while i < count { fds[i].returned = poll_events(events[i * 4 + 3]) i = i + 1 }
    }
    free(storage)
    if result < 0 { make code = errno_address() code.* = saved_errno }
    if result < 0 { return error.OSFailed }
    return result
}

