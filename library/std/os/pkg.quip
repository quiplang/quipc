@pub @unsafe
make strlcpy (destination: ptr<char>, source: ptr<char>, size: u64) -> u64 {
    make length = strlen(source)
    if size == 0 { return length }
    make count = length
    if count >= size { count = size - 1 }
    make i: uint = 0
    while i < count { destination[i] = source[i] i = i + 1 }
    destination[count] = '\0'
    return length
}
@pub @unsafe
make strlcat (destination: ptr<char>, source: ptr<char>, size: u64) -> u64 {
    make length = strnlen(destination, size)
    if length == size { return size + strlen(source) }
    return length + strlcpy(destination + length, source, size - length)
}

