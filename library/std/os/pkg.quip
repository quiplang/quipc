}

@impl StreamMode
make translate () -> str {
    return match this.* {
        StreamMode.Read => "r"
        StreamMode.Write => "w"
        StreamMode.Append => "a"
        StreamMode.ReadWrite => "r+"
        StreamMode.WriteRead => "w+"
        StreamMode.AppendRead => "a+"
        _ => ""
    }
}

@pub
make type OpenOptions {
    @pub {
        make access: FileAccess = FileAccess.Read
        make create: bool = false
        make exclusive: bool = false
        make truncate: bool = false
        make append: bool = false
        make nonblocking: bool = false
        make close_on_exec: bool = false
        make permissions: u32 = 420
    }
}

@impl OpenOptions
make translate () -> i32 {
    make flags = this.access.translate()
    @target "macos" {
        if this.create { flags = flags | 512 }
        if this.exclusive { flags = flags | 2048 }
        if this.truncate { flags = flags | 1024 }
        if this.append { flags = flags | 8 }
        if this.nonblocking { flags = flags | 4 }
        if this.close_on_exec { flags = flags | 16777216 }
    }
    @target "linux" {
        if this.create { flags = flags | 64 }
        if this.exclusive { flags = flags | 128 }
        if this.truncate { flags = flags | 512 }
        if this.append { flags = flags | 1024 }
        if this.nonblocking { flags = flags | 2048 }
        if this.close_on_exec { flags = flags | 524288 }
    }
    return flags
}

@pub
make type Directory {
    @pub {
        make fd: i32 = -1
    }
}

// A default Directory selects the current working directory for *at calls.
@impl Directory
make translate () -> i32 {
    if this.fd >= 0 { return this.fd }
    @target "macos" { return -2 }
    @target "linux" { return -100 }
}

