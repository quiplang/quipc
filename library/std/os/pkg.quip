@pub @unsafe
make fstat (fd: i32, output: ptr<FileInfo>) -> !void {
    make storage: NativeStat = .{}
    @unsafe make address: ptr<any> = storage.pin
    make result: i32 = 0
    @target "macos" { result = native::fstat(fd, address) }
    @target "linux" { result = native::fstat(fd, address) }
    if result < 0 { return error.OSFailed }
    @unsafe make words: ptr<u64> = storage.pin
    make info: FileInfo = .{}
    make mode: u64 = 0
    @target "macos" {
        mode = (words[0] >> 32) & 65535
        info.device = words[0] & 4294967295
        info.inode = words[1]
        info.links = words[0] >> 48
        @unsafe info.owner = words[2] & 4294967295
        @unsafe info.group = words[2] >> 32
        @unsafe info.size = words[12]
        @unsafe info.blocks = words[13]
        @unsafe info.block_size = words[14] & 4294967295
        @unsafe info.accessed.seconds = words[4]
        @unsafe info.accessed.nanoseconds = words[5]
        @unsafe info.modified.seconds = words[8]
        @unsafe info.modified.nanoseconds = words[9]
        @unsafe info.changed.seconds = words[6]
        @unsafe info.changed.nanoseconds = words[7]
    }
    @target "linux" {
        // stat's mode/uid/gid/nlink placement differs on x86_64 and aarch64.
        // utsname is 390 bytes, so reserve a separate 512-byte object.
        make name: UnameStorage = .{}
        @unsafe make name_address: ptr<any> = name.pin
        if native::uname(name_address) != 0 { return error.OSFailed }
        @unsafe make bytes: ptr<char> = name.pin
        if bytes[260] == 'x' {
            mode = words[3] & 4294967295
            info.links = words[2]
            @unsafe info.owner = words[3] >> 32
            @unsafe info.group = words[4] & 4294967295
        } elif bytes[260] == 'a' {
            mode = words[2] & 4294967295
            info.links = words[2] >> 32
            @unsafe info.owner = words[3] & 4294967295
            @unsafe info.group = words[3] >> 32
        } else { set_errno(ErrorCode.NotSupported) return error.OSFailed }
        info.device = words[0]
        info.inode = words[1]
        @unsafe info.size = words[6]
        @unsafe info.block_size = words[7] & 4294967295
        @unsafe info.blocks = words[8]
        @unsafe info.accessed.seconds = words[9]
        @unsafe info.accessed.nanoseconds = words[10]
        @unsafe info.modified.seconds = words[11]
        @unsafe info.modified.nanoseconds = words[12]
        @unsafe info.changed.seconds = words[13]
        @unsafe info.changed.nanoseconds = words[14]
    }
    @unsafe info.permissions = mode & 4095
    match mode & 61440 {
        32768 { info.kind = FileKind.Regular }
        16384 { info.kind = FileKind.Directory }
        40960 { info.kind = FileKind.Symlink }
        24576 { info.kind = FileKind.BlockDevice }
        8192 { info.kind = FileKind.CharacterDevice }
        4096 { info.kind = FileKind.Fifo }
        49152 { info.kind = FileKind.Socket }
        _ {}
    }
    output.* = info
    return
}


make type UnameStorage {
    make block0: NativeStat = .{}
    make block1: NativeStat = .{}
    make block2: NativeStat = .{}
    make block3: NativeStat = .{}
    make block4: NativeStat = .{}
}

@pub
make type SystemInfo {
    @pub {
        make system: str = ""
        make node: str = ""
        make release: str = ""
        make version: str = ""
        make machine: str = ""
    }
}

@pub
make system_info () -> !SystemInfo {
    make storage: UnameStorage = .{}
    @unsafe {
        make address: ptr<any> = storage.pin
        make result: i32 = 0
        @target "macos" { result = native::uname(address) }
        @target "linux" { result = native::uname(address) }
        if result < 0 { return error.SystemInfoFailed }
        make bytes: ptr<char> = storage.pin
        make stride: uint = 0
        @target "macos" { stride = 256 }
        @target "linux" { stride = 65 }
        make info = SystemInfo {}
        make field: uint = 0
        while field < 5 {
            make text: str = ""
            make offset = field * stride
            make i: uint = 0
            while i < stride && bytes[offset + i] != '\0' { text.push(bytes[offset + i]) i++ }
            match field {
                0 { info.system = text }
                1 { info.node = text }
                2 { info.release = text }
                3 { info.version = text }
                _ { info.machine = text }
            }
            field++
        }
        return info
    }
}

// Convert status/foreign ABI signal numbers at the OS boundary.
@pub
make signal_from_number (number: i32) -> !Signal {
    @target "macos" {
        match number {
            0 { return Signal.None }
            1 { return Signal.Hangup }
            2 { return Signal.Interrupt }
            3 { return Signal.Quit }
            4 { return Signal.IllegalInstruction }
            5 { return Signal.Trap }
            6 { return Signal.Abort }
            10 { return Signal.Bus }
            8 { return Signal.FloatingPoint }
            9 { return Signal.Kill }
            30 { return Signal.User1 }
            11 { return Signal.SegmentationFault }
            31 { return Signal.User2 }
            13 { return Signal.Pipe }
            14 { return Signal.Alarm }
            15 { return Signal.Terminate }
            20 { return Signal.Child }
            19 { return Signal.Continue }
            17 { return Signal.Stop }
            18 { return Signal.TerminalStop }
            21 { return Signal.TerminalInput }
            22 { return Signal.TerminalOutput }
            16 { return Signal.Urgent }
            24 { return Signal.CpuLimit }
            25 { return Signal.FileLimit }
            26 { return Signal.VirtualAlarm }
            27 { return Signal.Profiling }
            28 { return Signal.WindowChanged }
            23 { return Signal.Io }
            12 { return Signal.BadSystemCall }
            _ {}
        }
    }
    @target "linux" {
        match number {
            0 { return Signal.None }
            1 { return Signal.Hangup }
            2 { return Signal.Interrupt }
            3 { return Signal.Quit }
            4 { return Signal.IllegalInstruction }
            5 { return Signal.Trap }
            6 { return Signal.Abort }
            7 { return Signal.Bus }
            8 { return Signal.FloatingPoint }
            9 { return Signal.Kill }
            10 { return Signal.User1 }
            11 { return Signal.SegmentationFault }
            12 { return Signal.User2 }
            13 { return Signal.Pipe }
            14 { return Signal.Alarm }
            15 { return Signal.Terminate }
            17 { return Signal.Child }
            18 { return Signal.Continue }
            19 { return Signal.Stop }
            20 { return Signal.TerminalStop }
            21 { return Signal.TerminalInput }
            22 { return Signal.TerminalOutput }
            23 { return Signal.Urgent }
            24 { return Signal.CpuLimit }
            25 { return Signal.FileLimit }
            26 { return Signal.VirtualAlarm }
            27 { return Signal.Profiling }
            28 { return Signal.WindowChanged }
            29 { return Signal.Io }
            31 { return Signal.BadSystemCall }
            _ {}
        }
    }
    return error.UnknownSignal
}

// Opaque storage; construct and modify sets through sigemptyset/sigaddset.
@pub
make type SignalSet {
    make word0: u64 = 0
    make word1: u64 = 0
    make word2: u64 = 0
    make word3: u64 = 0
    make word4: u64 = 0
    make word5: u64 = 0
    make word6: u64 = 0
    make word7: u64 = 0
    make word8: u64 = 0
    make word9: u64 = 0
    make word10: u64 = 0
    make word11: u64 = 0
    make word12: u64 = 0
    make word13: u64 = 0
    make word14: u64 = 0
    make word15: u64 = 0
}

@pub
make type SignalOptions {
    @pub {
        make restart: bool = false
        make on_stack: bool = false
        make reset_handler: bool = false
        make no_defer: bool = false
        make no_child_stop: bool = false
        make no_child_wait: bool = false
        make siginfo: bool = false
    }
}

@impl SignalOptions
make translate () -> i32 {
    make flags: i32 = 0
    @target "macos" {
        if this.restart { flags = flags | 2 }
        if this.on_stack { flags = flags | 1 }
        if this.reset_handler { flags = flags | 4 }
        if this.no_defer { flags = flags | 16 }
        if this.no_child_stop { flags = flags | 8 }
        if this.no_child_wait { flags = flags | 32 }
        if this.siginfo { flags = flags | 64 }
    }
    @target "linux" {
        if this.restart { flags = flags | 268435456 }
        if this.on_stack { flags = flags | 134217728 }
        if this.reset_handler { flags = flags | -2147483648 }
        if this.no_defer { flags = flags | 1073741824 }
        if this.no_child_stop { flags = flags | 1 }
        if this.no_child_wait { flags = flags | 2 }
        if this.siginfo { flags = flags | 4 }
    }
    return flags

}

make signal_options (flags: i32) -> SignalOptions {
    make options: SignalOptions = .{}
    @target "macos" {
        options.restart = (flags & 2) != 0
        options.on_stack = (flags & 1) != 0
        options.reset_handler = (flags & 4) != 0
        options.no_defer = (flags & 16) != 0
        options.no_child_stop = (flags & 8) != 0
        options.no_child_wait = (flags & 32) != 0
        options.siginfo = (flags & 64) != 0
    }
    @target "linux" {
        options.restart = (flags & 268435456) != 0
        options.on_stack = (flags & 134217728) != 0
        options.reset_handler = (flags & -2147483648) != 0
        options.no_defer = (flags & 1073741824) != 0
        options.no_child_stop = (flags & 1) != 0
        options.no_child_wait = (flags & 2) != 0
        options.siginfo = (flags & 4) != 0
    }
    return options
}

@pub
make type SignalAction {
    @pub {
        // Native C callback; its signature must match options.siginfo.
        make handler: ptr<any>
        make mask: SignalSet = .{}
        make options: SignalOptions = .{}
    }
}

@pub @unsafe
make sigemptyset (mask: ptr<SignalSet>) -> !void {
    mask.* = SignalSet {}
    @target "macos" {
        make native_result = native::sigemptyset(mask)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::sigemptyset(mask)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make sigaddset (mask: ptr<SignalSet>, signal: Signal) -> !void {
    make number = signal.translate()
    @target "macos" {
        make native_result = native::sigaddset(mask, number)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::sigaddset(mask, number)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

@pub @unsafe
make sigprocmask (how: SignalMaskHow, mask: ptr<SignalSet>, previous: ptr<SignalSet>) -> !void {
    make operation = how.translate()
    @target "macos" {
        make native_result = native::sigprocmask(operation, mask, previous)
        if native_result < 0 { return error.OSFailed }
        return
    }
    @target "linux" {
        make native_result = native::sigprocmask(operation, mask, previous)
        if native_result < 0 { return error.OSFailed }
        return
    }
}

// Marshal C sigaction explicitly: Darwin's mask/flags follow an 8-byte handler;
// glibc's 128-byte mask precedes flags and the restorer pointer.
@pub @unsafe
make sigaction (signal: Signal, action: ptr<SignalAction>, previous: ptr<SignalAction>) -> !void {
    make number = signal.translate()
    make input: NativeStat = .{}
    make output: NativeStat = .{}
    @unsafe make null: ptr<any> = 0
    @unsafe make no_action: ptr<SignalAction> = 0
    @unsafe make input_bytes: ptr<char> = input.pin
    @unsafe make output_bytes: ptr<char> = output.pin
    make input_address = null
    make output_address = null
    if action != no_action {
        input_address = input_bytes
        @unsafe make handler: ptr<ptr<any>> = input_bytes
        handler.* = action.*.handler
        make flags = action.*.options.translate()
        @target "macos" {
            memcpy(input_bytes + 8, action.*.mask.pin, 4)
            @unsafe make flag_address: ptr<i32> = input_bytes + 12
            flag_address.* = flags
        }
        @target "linux" {
            memcpy(input_bytes + 8, action.*.mask.pin, 128)
            @unsafe make flag_address: ptr<i32> = input_bytes + 136
            flag_address.* = flags
        }
    }
    if previous != no_action { output_address = output_bytes }
    make result: i32 = 0
    @target "macos" { result = native::sigaction(number, input_address, output_address) }
    @target "linux" { result = native::sigaction(number, input_address, output_address) }
    if result == 0 && previous != no_action {
        @unsafe make handler: ptr<ptr<any>> = output_bytes
        previous.*.handler = handler.*
        previous.*.mask = SignalSet {}
        @target "macos" {
            memcpy(previous.*.mask.pin, output_bytes + 8, 4)
            @unsafe make flag_address: ptr<i32> = output_bytes + 12
            previous.*.options = signal_options(flag_address.*)
        }
        @target "linux" {
            memcpy(previous.*.mask.pin, output_bytes + 8, 128)
            @unsafe make flag_address: ptr<i32> = output_bytes + 136
            previous.*.options = signal_options(flag_address.*)
        }
    }
    if result < 0 { return error.OSFailed }
    return
}

