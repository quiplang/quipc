@impl Signal
make translate () -> i32 {
    @target "macos" {
        return match this.* {
            Signal.None => 0
            Signal.Hangup => 1
            Signal.Interrupt => 2
            Signal.Quit => 3
            Signal.IllegalInstruction => 4
            Signal.Trap => 5
            Signal.Abort => 6
            Signal.Bus => 10
            Signal.FloatingPoint => 8
            Signal.Kill => 9
            Signal.User1 => 30
            Signal.SegmentationFault => 11
            Signal.User2 => 31
            Signal.Pipe => 13
            Signal.Alarm => 14
            Signal.Terminate => 15
            Signal.Child => 20
            Signal.Continue => 19
            Signal.Stop => 17
            Signal.TerminalStop => 18
            Signal.TerminalInput => 21
            Signal.TerminalOutput => 22
            Signal.Urgent => 16
            Signal.CpuLimit => 24
            Signal.FileLimit => 25
            Signal.VirtualAlarm => 26
            Signal.Profiling => 27
            Signal.WindowChanged => 28
            Signal.Io => 23
            Signal.BadSystemCall => 12
            _ => -1
        }
    }
    @target "linux" {
        return match this.* {
            Signal.None => 0
            Signal.Hangup => 1
            Signal.Interrupt => 2
            Signal.Quit => 3
            Signal.IllegalInstruction => 4
            Signal.Trap => 5
            Signal.Abort => 6
            Signal.Bus => 7
            Signal.FloatingPoint => 8
            Signal.Kill => 9
            Signal.User1 => 10
            Signal.SegmentationFault => 11
            Signal.User2 => 12
            Signal.Pipe => 13
            Signal.Alarm => 14
            Signal.Terminate => 15
            Signal.Child => 17
            Signal.Continue => 18
            Signal.Stop => 19
            Signal.TerminalStop => 20
            Signal.TerminalInput => 21
            Signal.TerminalOutput => 22
            Signal.Urgent => 23
            Signal.CpuLimit => 24
            Signal.FileLimit => 25
            Signal.VirtualAlarm => 26
            Signal.Profiling => 27
            Signal.WindowChanged => 28
            Signal.Io => 29
            Signal.BadSystemCall => 31
            _ => -1
        }
    }
}

