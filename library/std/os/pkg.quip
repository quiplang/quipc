// The public OS boundary. Native bindings, flag values and ABI layouts stay here.
// Raw pointer operations require @unsafe: C strings must be NUL terminated,
// buffers must hold the requested byte count, and native handles must be valid.
// Fallible operations return !T. On failure, query errno()/error_is() immediately in catch.
// EOF, partial reads/writes and unsuccessful searches remain ordinary results.
@import "../../runtime/str_methods.quip"

@pure @const {
    @target "macos" make native = @import "macos.quip"
    @target "linux" make native = @import "linux.quip"
}

@pub @const {
    make STDIN: i32 = 0
    make STDOUT: i32 = 1
    make STDERR: i32 = 2
}

@pub
make enum FileAccess {
    Read,
    Write,
    ReadWrite,
}

@impl FileAccess
make translate () -> i32 {
    @target "macos" {
        return match this.* {
            FileAccess.Read => 0
            FileAccess.Write => 1
            FileAccess.ReadWrite => 2
            _ => -1
        }
    }

    @target "linux" {
        return match this.* {
            FileAccess.Read => 0
            FileAccess.Write => 1
            FileAccess.ReadWrite => 2
            _ => -1
        }
    }
}

