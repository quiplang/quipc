@pure @const make c_ffi = @import "./ffi/c.quip"
@pure @const make runtime = @import "../runtime/pkg.quip"
@pure @const make panic_runtime = @import "../runtime/panic.quip"

@pub @pure @const {

    make math: unit = @import "./math/pkg.quip"
    make io: unit = @import "./io/pkg.quip"
    make os: unit = @import "./os/pkg.quip"
    make mem: unit = @import "./mem/pkg.quip"
    make process: unit = @import "./process/pkg.quip"
    make collections = @import "./collections/pkg.quip"
    make time: unit = @import "./time/pkg.quip"
    make progress: unit = @import "./progress/pkg.quip"
    make json: unit = @import "./json/pkg.quip"

    make __impl: unit = @import "./impl/pkg.quip"
}



@pub
make type Options {

    @pub {
        make show_quipc_debug: bool
        make show_memory_dump: bool
        make hide_warnings: bool
    }

    @pub
    make default () -> Options {
        return Options {
            show_quipc_debug = false,
            show_memory_dump = false,
            hide_warnings = false,
        }
    }
}

@pub
make enum Mode {
    Release,
    Debug,
}

@pub
make enum Platform {
    Native,
    Macos,
    Linux,
    Windows,
}

@pub
make enum Optimization {
    None,
    Standard,
    Aggressive,
    Size,
    Memory,
}

// Tuple strings are passed directly as argv values, without shell interpretation.
make package_quote (text: str) -> str {
    make out: str = "\""
    make i: uint = 0

    while i < text.len() {
        make c = text[i]

        if c == '\\' || c == '"' { out.push('\\') }

        out.push(c)
        i = i + 1
    }

    out.push('"')
    return out
}

@pub
make type Package {

    @pub {
        make name: str?
        make version: str
        make path: io::Path
    }

    @pub
    make create (name: str, path: str) -> Package {
        return Package {
            name = name,
            path = io::Path.create(path),
            version = "0.0.1"
        }
    }

}

@pub
make type Executable {

    @pub {
        make name: str
        make path_build: io::Path
        make platform: Platform
        make optimization: Optimization

        make entry_file: io::Path
        make entry_point: str
        make packages: Package[] = []
        make native_libraries: str[] = []
        make args: str[] = []

        // a test runner that prints its own case counts and failure names
        make reports_test_results: bool = false
    }

    @pub
    make default () -> Executable {
        return Executable {
            name = "",
            entry_file = io::Path.create("src/main.quip"),
            entry_point = "main",
            path_build = io::Path {},
            platform = Platform.Native,
            optimization = Optimization.None,
        }
    }

    /// registers a source module under an import name.
    @pub @this
    make add_import (name: str, path: str) { this.packages.push(Package.create(name, path)) }

    @pub @this
    make construct_args () {
        while this.args.len() > 0 { make _ = this.args.pop() }

        match this.platform {
            Platform.Macos {
                this.args.push("--platform")
                this.args.push("macos")
            }

            Platform.Linux {
                this.args.push("--platform")
                this.args.push("linux")
            }

            Platform.Windows {
                this.args.push("--platform")
                this.args.push("windows")
            }

            _ {}
        }

        match this.optimization {
            Optimization.Standard { this.args.push("-O2") }
            Optimization.Aggressive { this.args.push("-O3") }
            Optimization.Size { this.args.push("-Os") }
            _ {}
        }

        if this.path_build.get().len() > 0 {
            this.args.push("-o")
            make out_path: str = this.path_build.get() + "/" + this.name
            this.args.push(out_path.copy())

        } elif this.name.len() > 0 {
            this.args.push("--name")
            this.args.push(this.name.copy())
        }

        this.args.push("--entry")
        this.args.push(this.entry_point.copy())

        for pkg : this.packages.iter() {
            match pkg.name {
                none {}
                some { this.args.push("--alias=(" + package_quote(some) + "," + package_quote(pkg.path.get()) + ")") }
            }
        }


        for library : this.native_libraries.iter() {
            this.args.push("--link")
            this.args.push(library !)
        }

        this.args.push("compile")
        make entry_path: str = this.entry_file.get()
        this.args.push(entry_path.copy())
    }

    @pub
    make nothing () {
        return
    }
}



@pub
make type BuildStep {
    make name: str
    make action: () -> !void
    make always: bool = false
}

@pub
make type Build {

    @pub {
        make options: Options
        make mode: Mode
        make compiler_path: str = ""
        make optimization: Optimization = Optimization.None

        make keep_llvm: bool = false
        make progress_enabled: bool = true
        make script_args: str[] = []

        make args: str[]

        make executables: Executable[]
        make tests: Executable[] = []
        make test_steps: BuildStep[] = []
        make steps: BuildStep[] = []
        make selected_step: str = ""

        make packages: Package[] = []
    }

    @pub
    make default () -> Build {
        make b = Build.initial()
        load_legacy_build_context(b.pin)
        return b
    }

    make initial () -> Build {
        make b = Build {
            options = Options.default(),
            mode = Mode.Debug,
            args = [],
            executables = [],
        }

        b.compiler_path = "quipc"
        return b
    }


    /// Reads optional build settings and keeps the remaining script arguments.
    @pub
    make from_args (argv: ptr<char>[]) -> !Build {
        make b = Build.initial()
        make i: uint = 1
        if argv.len() > 1 && c_ffi::to_str(argv[1]) == "--quip-build-args" {
            i = load_build_args(b.pin, argv !) catch err { return err }
        } else {
            load_legacy_build_context(b.pin)
        }
        while i < argv.len() {
            b.script_args.push(c_ffi::to_str(argv[i]))
            i++
        }
        return b
    }

    @pub @this
    make proceed () -> !int[] {
        make result: int[] = []

        make found = this.selected_step.len() == 0
        make defaults: uint = 0

        for step : this.steps.iter() {
            if step.name == this.selected_step { found = true }

            if step.always { defaults = defaults + 1 }
        }

        if !found {
            progress::fail("unknown build step: " + this.selected_step)
            return error.UnknownBuildStep
        }

        if this.executables.len() == 0 && this.tests.len() == 0 && this.test_steps.len() == 0 && defaults == 0 && this.selected_step.len() == 0 {
            progress::fail("no targets or default steps to build")
            return error.NoExecutables
        }

        this.construct_args()
        make total = this.executables.len() + defaults

        if this.selected_step.len() > 0 {
            for step : this.steps.iter() {
                if !step.always && step.name == this.selected_step { total = total + 1 }
            }
        }

        make completed: uint = 0
        for exe : this.executables.iter() {

            exe.construct_args()

            make args: str[] = []
            make i: int = 0
            while i < this.args.len() {
                args.push(this.args[i] !)
                i = i + 1
            }

            make j: int = 0
            while j < exe.args.len() {
                args.push(exe.args[j] !)
                j = j + 1
            }

            progress::phase("Build executable", completed, total, exe.entry_file.get())
            make command = process::Command.create(this.compiler_path !, args)

            if this.options.show_quipc_debug { progress::log(command.get()) }

            progress::clear()

            make code = process::Process.run(command)

            if code != 0 {
                return error.FailedToBuild
            }

            result.push(code)
            completed = completed + 1
        }

        if !this.run_tests() { return error.FailedToBuild }

        for step : this.steps.iter() {
            if step.always || step.name == this.selected_step {
                progress::phase("Step", completed, total, step.name !)
                step.action() catch {
                    progress::fail("build step failed: " + step.name)
                    return error.FailedToBuild
                }
                completed = completed + 1
                progress::phase("Step", completed, total, step.name !)
            }
        }

        return result
    }

    // One runner imports and calls all test modules and source-level tests.
    // Reconfiguration replaces the previous runner.
    @pub @this
    make set_test_runner (exe: Executable) {
        while this.tests.len() > 0 { make _ = this.tests.pop() }

        if exe.name.len() == 0 { exe.name = "tests" }

        this.tests.push(exe)
    }

    // Call imported source-level tests from a fallible callback.
    @pub @this
    make add_test_step (name: str, action: () -> !void) {
        this.test_steps.push(BuildStep { name = name, action = action })
    }

    @pub @this
    make run_tests () -> bool {
        this.construct_args()
        make passed: uint = 0
        make failed: uint = 0
        make total = this.tests.len() + this.test_steps.len()

        for exe : this.tests.iter() {
            if exe.path_build.get().len() == 0 {
                make profile: str = "debug"

                if this.mode == Mode.Release { profile = "release" }

                exe.path_build = io::Path.create("target/" + profile + "/test")
            }

            exe.construct_args()
            make args: str[] = []

            for arg : this.args.iter() { args.push(arg !) }

            for arg : exe.args.iter() { args.push(arg !) }

            progress::phase("Test", passed + failed, total, exe.name !)
            // Let the compiler own terminal progress while compiling the runner.
            progress::clear()
            make command = process::Command.create(this.compiler_path !, args)
            make code = process::Process.run(command)

            if code != 0 {
                progress::fail("test compilation failed: " + exe.name + " (status " + code.to_str() + ")")
                failed = failed + 1
                continue
            }

            make path = exe.path_build.get() + "/" + exe.name
            // Relative executable paths must contain a slash for process lookup.
            make status = progress::run(path, [])

            if status != 0 {
                if !exe.reports_test_results || status != 1 {
                    progress::fail("test failed: " + exe.name + " (status " + status.to_str() + ")")
                }

                failed = failed + 1
            } else {
                if !exe.reports_test_results {
                    progress::note("test passed: " + exe.name)
                }

                passed = passed + 1
            }
        }

        for step : this.test_steps.iter() {
            progress::phase("Test", passed + failed, total, step.name !)
            make ok = true
            step.action() catch { ok = false }

            if ok {
                progress::note("test passed: " + step.name)
                passed = passed + 1
            } else {
                progress::fail("test failed: " + step.name)
                failed = failed + 1
            }
        }

        if total > 0 && this.options.show_quipc_debug {
            progress::note("test targets: " + passed.to_str() + " passed, " + failed.to_str() + " failed")
        }

        return failed == 0
    }

    // Named steps run only when selected with `quipc build <name>`.
    @pub @this
    make add_step (name: str, action: () -> !void) {
        this.steps.push(BuildStep { name = name, action = action })
    }

    // Post-build steps run on every successful build, in registration order.
    @pub @this
    make add_post_step (name: str, action: () -> !void) {
        this.steps.push(BuildStep { name = name, action = action, always = true })
    }

    @pub @this

    @pub @this
    make add_package (pkg: Package) -> void {
        this.packages.push(pkg)
    }

    @pub @this
    make construct_args () {
        while this.args.len() > 0 { make _ = this.args.pop() }

        match this.optimization {
            Optimization.Standard { this.args.push("-O2") }
            Optimization.Aggressive { this.args.push("-O3") }
            Optimization.Size { this.args.push("-Os") }
            _ {}
        }

        for pkg : this.packages.iter() {
            match pkg.name {
                none {}
                some {
                    this.args.push("--alias=(" + package_quote(some) + "," + package_quote(pkg.path.get()) + ")")
                }
            }
        }

        match this.mode {
            Mode.Debug { this.args.push("-g") }
            Mode.Release { this.args.push("--release") }
            _ {}
        }

        if this.options.hide_warnings {
            this.args.push("--hide-warnings")
        }

        if this.options.show_memory_dump { this.args.push("--emit-mem") }

        if this.keep_llvm { this.args.push("--keep-llvm") }
        if !this.progress_enabled { this.args.push("--no-progress") }
    }

    @pub @this
    make add_executable (exe: Executable) {
        this.executables.push(exe)
    }

    @pub @this
    make checkout () { // show the current Build status in the terminal
        io::println("==== BUILD ====")

        io::println("")

        for exe : this.executables.iter() {
            io::println("----")
            io::println(exe.name)
            io::println(exe.entry_file.get())
            io::println(exe.entry_point)
            io::println(exe.path_build.get())
            io::println("")
        }

        io::println("===============")
    }
}

make set_build_profile (b: ref<Build>, profile: str, optimization: str) {
    if profile == "release" { b.*.mode = Mode.Release }
    if optimization == "-O2" { b.*.optimization = Optimization.Standard }
    elif optimization == "-O3" { b.*.optimization = Optimization.Aggressive }
    elif optimization == "-Os" { b.*.optimization = Optimization.Size }
}

// Consume the driver arguments up to the separator, leaving script arguments intact.
make load_build_args (b: ref<Build>, argv: ptr<char>[]) -> !uint {
    if argv.len() < 5 { return error.InvalidBuildArguments }
    b.*.compiler_path = c_ffi::to_str(argv[2])
    b.*.selected_step = c_ffi::to_str(argv[3])

    make i: uint = 4
    while i < argv.len() {
        match c_ffi::to_str(argv[i]) {
            "--" { return i + 1 }
            "--release" { b.*.mode = Mode.Release }
            "-O2" { b.*.optimization = Optimization.Standard }
            "-O3" { b.*.optimization = Optimization.Aggressive }
            "-Os" { b.*.optimization = Optimization.Size }
            "--keep-llvm" { b.*.keep_llvm = true }
            "--no-progress" { b.*.progress_enabled = false }
            "--verbose" { b.*.options.show_quipc_debug = true }
            "--alias" {
                if i + 2 >= argv.len() { return error.InvalidBuildArguments }
                b.*.add_package(Package.create(c_ffi::to_str(argv[i + 1]), c_ffi::to_str(argv[i + 2])))
                i += 2
            }
            _ { return error.InvalidBuildArguments }
        }
        i++
    }
    return error.InvalidBuildArguments
}

// Older bootstrap drivers supply their settings through the environment.
make load_legacy_build_context (b: ref<Build>) {
    b.*.options.show_quipc_debug = os::getenv("QUIPC_VERBOSE") == "1"
    b.*.progress_enabled = os::getenv("QUIPC_NO_PROGRESS") != "1"
    make compiler = os::getenv("QUIPC_COMPILER")
    if compiler.len() > 0 { b.*.compiler_path = compiler }
    b.*.keep_llvm = os::getenv("QUIPC_KEEP_LLVM") == "1"
    b.*.selected_step = os::getenv("QUIPC_STEP")
    set_build_profile(b, os::getenv("QUIPC_PROFILE"), os::getenv("QUIPC_OPTIMIZATION"))

    make i: uint = 0
    while true {
        make suffix = i.to_str()
        make name = os::getenv("QUIPC_PACKAGE_NAME_" + suffix.copy())
        if name.len() == 0 { break }
        b.*.add_package(Package.create(name, os::getenv("QUIPC_PACKAGE_PATH_" + suffix)))
        i++
    }
}



@impl char
make is_space () -> bool {
    make c = this.deref
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

@impl char
make is_alpha () -> bool {
    make c = this.deref
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

@impl char
make is_alnum () -> bool {
    make c = this.deref
    return this.is_alpha() || (c >= '0' && c <= '9')
}

@impl char
make is_digit () -> bool {
    make c = this.deref

    return c >= '0' && c <= '9'
}

@pub
make todo (fmt: variant<str, String>, line: int, file: String) {

    match fmt {
        a: str {
        }

        b: String {
        }
    }

    process::abort()
}


@pub
make test () -> !void {

    io::test() catch {
        io::println("io package test failed")
        return error.TestFailed
    }


    return
}

/// Prints a panic message with its source location and terminates the process.
@pub
make panic (message: str, file: str, line: int) -> void {
    make message_bytes = message.copy()
    make file_bytes = file.copy()
    message_bytes.push('\0')
    file_bytes.push('\0')

    @unsafe {
        make source_line: i32 = line
        panic_runtime::runtime_panic(message_bytes.data, file_bytes.data, source_line)
    }
}
