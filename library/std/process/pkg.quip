// the process library
@pure @const {
make os: unit = @import "../os/pkg.quip"

make io: unit = @import "../io/pkg.quip"

make to_str: unit = @import "../fmt/pkg.quip"
make native: unit = @import "../internal/process.quip"
}

@pub
make enum ProcessState {
    None,
    Running,
    Exited,
    Signaled,
}

@pub
make type Command {

    @pub {
        make name: str = ""
        make args: str[] = []

        make env: str[] = []
        make work_dir: str? = none

        // Negative descriptors inherit the parent stream, including with older runtimes.
        make fd_in: int = -1
        make fd_out: int = -1
        make fd_err: int = -1
    }

    @pub
    make create (name: str, args: str[]) -> Command {
        make command: Command = Command {}
        command.name = name
        command.args = args
        return command
    }

    @pub @this
    make get () -> str {
        make result: str = ""

        result.push(this.name.copy())
        result.push(" ")

        make i: int = 0
        while i < this.args.len() {
            result.push(this.args[i])
            result.push(" ")
            i = i + 1
        }

        return result
    }

    @pub @this
    make ensure () -> !void {
        return
    }
}

@pub
make type Process {

    @pub {
        make command: Command = .{}

        make pid: int = 0

        make state: ProcessState = ProcessState.None

        make exit_code: int = 0
        make signal_code: int = 0
    }


    @pub
    make spawn (command: Command) -> !Process {
        make pid: int = os::syscall::quip_spawn_process(
            command.name.pin, command.args.pin,
            command.fd_in, command.fd_out, command.fd_err
        )

        if pid < 0 {
            return error.ProcessSpawnFailed
        }

        make proc: Process = Process {}
        proc.pid = pid
        proc.state = ProcessState.Running
        proc.command = command

        return proc
    }

    @pub @this
    make wait () {
        make result: int = os::syscall::quip_wait_process(this.pid)

        if result >= 0 {
            this.state = ProcessState.Exited
            this.exit_code = result
        } else {
            this.state = ProcessState.Signaled
            this.signal_code = 0 - result
        }
    }

    @pub @this
    make kill () {
        os::syscall::quip_kill_process(this.pid, 9)
        this.state = ProcessState.Signaled
        this.signal_code = 9
    }

    @pub
    make run (command: Command) -> int {

        make result: int = os::syscall::quip_run_process(
            command.name.pin, command.args.pin,
            command.fd_in, command.fd_out, command.fd_err)


        return result
    }
}

@pub
make exit (code: int) -> int {
    return os::syscall::exit(code)
}

@pub
make abort () -> void {
    os::syscall::quip_abort()
}
