@pure @const {
    make std = @import "std"
    make c = @import "../../library/std/ffi/c.quip"
}

make native_platform_name () -> str {
    make info = std::os::system_info() catch { return "" }
    if info.system == "Darwin" { return "macos" }
    if info.system == "Linux" { return "linux" }
    return ""
}

/// identifies the operation requested on the command line.
@pub
make enum CommandKind {
    None,
    Compile,
    Build,
    Run,
    Init,
    Help,
    Version,
}

/// stores command-line options and the inputs needed by the driver.
@pub
make type Config {

    @pub make command: CommandKind

    @pub make input: std::io::Path? = none
    @pub make output: std::io::Path

    @pub make options: std::Options
    make platform: std::Platform
    @pub make platform_name: str   // resolved OS name for @target selection

    @pub make dependencies: (str?, std::io::Path)[] = []

    @pub make run_args: str[] = []
    @pub make build_args: str[] = []
    @pub make run_project: bool = false

    @pub make emit_mir: bool = false
    @pub make emit_mem: bool = false

    @pub make emit_llvm_optimized: bool = false
    @pub make emit_llvm: bool = false        // print textual LLVM IR and stop (debug)
    @pub make entry: str = "main"            // entry point function name
    @pub make output_set: bool = false       // true if `-o` was given
    @pub make name: str = ""                 // optional executable basename
    @pub make entry_set: bool = false
    @pub make intermediate_directory: str = ""
    @pub make build_step: str = ""

    @pub
    make init () -> Config {
        make config = Config {}

        config.command = CommandKind.None

        config.output = std::io::Path.create("target/debug/")

        config.options = std::Options {}
        if std::process::Environment.get("QUIPC_NO_PROGRESS", "") == "1" { config.options.progress_enabled = false }
        config.platform = std::Platform.Native
        config.platform_name = native_platform_name()


        return config
    }

    /// registers a named source import or an unnamed native linker input.
    @pub @this
    make add_dependency (name: str?, path: str) -> !void {
        if path.len() == 0 { return error.InvalidArgument }

        if is_qlib(path.copy()) {
            if name == none {
                std::io::println("Quip libraries use --import NAME PATH; .qlib support is pending")
            } else {
                std::io::println("compiled .qlib imports are not supported yet")
            }
            return error.InvalidArgument
        }

        if name != none {
            make source_name = name.unwrap()
            if source_name.len() == 0 || path.len() < 5 { return error.InvalidArgument }

            if path[path.len() - 5] != '.' || path[path.len() - 4] != 'q' ||
                path[path.len() - 3] != 'u' || path[path.len() - 2] != 'i' || path[path.len() - 1] != 'p' {
                std::io::println("import aliases require a .quip source path")
                return error.InvalidArgument
            }

            make i: uint = 0

            while i < source_name.len() {
                make c = source_name[i]

                if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || (i > 0 && c >= '0' && c <= '9')) {
                    std::io::println("invalid source alias: " + source_name)

                    return error.InvalidArgument
                }

                i = i + 1
            }

            for (existing, existing_path) : this.dependencies.iter() {
                match existing {
                    some {
                        if some == source_name {
                            std::io::println("duplicate source alias: " + source_name)
                            return error.InvalidArgument
                        }
                    }
                    none {}
                }
            }
        }

        this.dependencies.push((name, std::io::Path.create(path)))
        return
    }

    /// parses the command line into compiler options.
    @pub @this
    make parse (argv: ptr<char>[]) -> !void {

        make i: uint = 0

        while i < argv.len() {

            make item = argv[i]
            make t = c::to_str(item)

            if t == "init" {
                this.command = CommandKind.Init

                if i + 1 < argv.len() {
                    make f = argv[i + 1]
                    i = i + 1
                    make tt = c::to_str(f)
                    this.input = std::io::Path.create(tt)

                } else {

                    return error.InvalidArgument
                }

            } elif t == "compile" {
                this.command = CommandKind.Compile


                if i + 1 < argv.len() {
                    make f = argv[i + 1]
                    i = i + 1
                    make tt = c::to_str(f)

                    if tt.len() == 0 || tt[0] == '-' { return error.InvalidArgument }

                    this.input = std::io::Path.create(tt)

                } else {
                    return error.InvalidArgument
                }

            } elif t == "build" {

                this.command = CommandKind.Build
                this.input = std::io::Path.create("./build.quip")

                if i + 1 < argv.len() {
                    make next_argument = c::to_str(argv[i + 1])

                    if next_argument.len() > 0 && next_argument[0] != '-' {
                        this.build_step = next_argument
                        i = i + 1
                    }
                }

            } elif t == "run" {
                this.command = CommandKind.Run
                this.run_project = true
                this.input = std::io::Path.create("src/main.quip")

                if i + 1 < argv.len() {
                    make next = c::to_str(argv[i + 1])

                    if next.len() > 0 && next[0] != '-' {
                        this.input = std::io::Path.create(next)
                        this.run_project = false
                        i = i + 1
                    }
                }
            } elif t == "--" && this.command == CommandKind.Build {
                i++
                while i < argv.len() {
                    this.build_args.push(c::to_str(argv[i]))
                    i++
                }
                break
            } elif t == "--" && this.command == CommandKind.Run {
                i = i + 1

                while i < argv.len() {
                    this.run_args.push(c::to_str(argv[i]))
                    i = i + 1
                }

                break

            } elif t == "--version" || t == "-V" {
                this.command = CommandKind.Version
            } elif t == "-h" || t == "--help" || t == "help" {
                this.command = CommandKind.Help

            } elif t == "-o" || t == "--output" {
                if i + 1 < argv.len() {
                    make f = argv[i + 1]
                    i = i + 1
                    make tt = c::to_str(f)
                    this.output = std::io::Path.create(tt)
                    this.output_set = true
                } else {
                    return error.InvalidArgument
                }
            } elif t == "--name" {
                if i + 1 < argv.len() {
                    i = i + 1
                    this.name = c::to_str(argv[i])
                } else {
                    return error.InvalidArgument
                }

            } elif t == "--import" {
                if i + 2 >= argv.len() {
                    std::io::println("--import requires NAME PATH")
                    return error.InvalidArgument
                }
                make name = c::to_str(argv[i + 1])
                make path = c::to_str(argv[i + 2])
                this.add_dependency(name, path) catch err { return err }

                i += 2

            } elif t == "--link" {
                if i + 1 >= argv.len() { return error.InvalidArgument }
                i = i + 1
                make path = c::to_str(argv[i])
                this.add_dependency(none, path) catch err { return err }

            } elif t == "--jobs" {
                if i + 1 >= argv.len() { return error.InvalidArgument }
                i++
                this.options.jobs = std::parse_jobs(c::to_str(argv[i])) catch {
                    std::io::println("--jobs requires a number between 1 and 256")
                    return error.InvalidArgument
                }
            } elif t == "--keep-llvm" {
                this.options.keep_llvm = true
            } elif t == "--emit-llvm-optimized" {
                this.emit_llvm = true
                this.emit_llvm_optimized = true
            } elif t == "--emit-llvm" || t == "--emit-llvm-raw" {
                this.emit_llvm = true
                this.emit_llvm_optimized = false
            } elif t == "--entry" {
                if i + 1 < argv.len() {
                    make f = argv[i + 1]
                    i = i + 1
                    this.entry = c::to_str(f)
                    this.entry_set = true
                } else {
                    return error.InvalidArgument
                }
            } elif t == "-O2" {
                this.options.optimization = std::Optimization.Standard
            } elif t == "-O3" {
                this.options.optimization = std::Optimization.Aggressive
            } elif t == "-Os" {
                this.options.optimization = std::Optimization.Size
            } elif t == "--benchmark" {
                this.options.benchmark = true
            } elif t == "--no-progress" {
                this.options.progress_enabled = false
            } elif t == "--show-debug" || t == "--verbose" {
                this.options.show_quipc_debug = true
            } elif t == "--extra-warnings" {
                this.options.extra_warnings = true
            } elif t == "--hide-warnings" {
                this.options.hide_warnings = true
            } elif t == "--memory-dump" {
                this.options.show_memory_dump = true
            } elif t == "--emit-mir" {
                this.emit_mir = true
            } elif t == "--emit-mem" {
                this.emit_mem = true
            } elif t == "--release" {
                this.options.mode = std::Mode.Release
            } elif t == "--debug" || t == "-g" {
                this.options.mode = std::Mode.Debug
            } elif t == "--build-simplified" {
                this.options.build_simplified = true
            } elif t == "--platform" {
                if i + 1 < argv.len() {
                    make f = argv[i + 1]
                    i = i + 1
                    make tt = c::to_str(f)

                    if tt == "windows" {
                        this.platform = std::Platform.Windows
                        this.platform_name = "windows"
                    } elif tt == "linux" {
                        this.platform = std::Platform.Linux
                        this.platform_name = "linux"
                    } elif tt == "macos" {
                        this.platform = std::Platform.Macos
                        this.platform_name = "macos"
                    }
                } else {
                    return error.InvalidArgument
                }
            } elif this.command == CommandKind.Build && this.build_step.len() == 0 && t.len() > 0 && t[0] != '-' {
                this.build_step = t
            } else {
                // argv[0] is the executable; every other unknown argument is an error.
                if i > 0 { return error.InvalidArgument }
            }

            i = i + 1
        }

        if this.options.benchmark {
            if (this.command != CommandKind.Compile && this.command != CommandKind.Build) || this.emit_llvm || this.emit_mir || this.emit_mem {
                std::io::println("--benchmark requires compile or build with full executable output")
                return error.InvalidArgument
            }
            this.options.progress_enabled = false
        }

        if this.command == CommandKind.Run && (this.emit_llvm || this.emit_mir || this.emit_mem || this.options.show_memory_dump) { return error.InvalidArgument }
    }
}

// Keep CLI suffix validation independent of extension methods from imported libraries.
make is_qlib (path: str) -> bool {
    make n = path.len()
    return n >= 5 && path[n - 5] == '.' && path[n - 4] == 'q'
        && path[n - 3] == 'l' && path[n - 2] == 'i' && path[n - 1] == 'b'
}
