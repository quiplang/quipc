@pure @const {
    make std = @import "std"


}

/// accumulates a digest for content fingerprints.
make type Hash {
    make a: uint = 0
    make b: uint = 0

    make init () -> Hash {
        @unsafe make first: uint = (0xcbf29ce4 << 32) | 0x84222325
        return Hash { a = first, b = 7809847782465536322 }
    }

    /// adds bytes to the hash.
    @this @unsafe
    make add (data: ptr<char>, length: uint) -> void {
        @unsafe make second: uint = (0xc2b2ae3d << 32) | 0x27d4eb4f

        make i: uint = 0

        while i < length {
            @unsafe make value: uint = data[i]
            value = value & 255
            this.a = (this.a ^ value) * 1099511628211
            this.b = (this.b ^ value) * second
            i = i + 1
        }
    }

    /// adds a length-delimited string to the hash.
    @this @unsafe
    make text (value: ref<str>) -> void {
        this.add(value.*.data, value.*.len())
        this.a = this.a * 1099511628211
        @unsafe make second: uint = (0xc2b2ae3d << 32) | 0x27d4eb4f
        this.b = this.b * second
    }

    /// formats the hash as hexadecimal text.
    @this
    make format () -> str {
        make digits: str = "0123456789abcdef"
        make output: str = ""

        make i: uint = 0

        while i < 32 {
            make word: uint = this.a
            make position = i

            if i >= 16 { word = this.b position = i - 16 }

            make index: uint = (word >> ((15 - position) * 4)) & 15
            output.push(digits[index])

            i = i + 1
        }

        return output
    }
}

/// records file metadata used when fingerprinting an input.
make type Stamp { make size: int = 0 make seconds: int = 0 make nanos: int = 0 }

/// reads the current platform-specific errno value.
@unsafe
make errno_value () -> i32 {
    @target "macos" { make code = std::os::platform::__error() return code.* }
    @target "linux" { make code = std::os::platform::__errno_location() return code.* }

    return 0
}

/// checks for zero.
make has_zero (value: ref<str>) -> bool {
    make i: uint = 0

    while i < value.*.len() {
        if value.*[i] == '\0' { return true }

        i = i + 1
    }

    return false
}

/// reads a regular file’s size and modification time from its file descriptor.
@unsafe
make stat_file (fd: i32) -> !Stamp {
    make storage: str = ""
    storage.reserve(256) catch { return error.OutOfMemory }

    if std::os::platform::fstat(fd, storage.data) != 0 { return error.StatFailed }

    @unsafe make words: ptr<int> = storage.data
    make result: Stamp = .{}
    make mode: int = 0

    @target "macos" {
        mode = (words[0] >> 32) & 65535
        result.size = words[12]
        result.seconds = words[8]
        result.nanos = words[9]
    }

    @target "linux" {
        make machine: str = ""
        machine.reserve(512) catch { return error.OutOfMemory }

        if std::os::platform::uname(machine.data) != 0 { return error.UnknownArchitecture }

        make data = machine.data

        if data[260] == 'x' { mode = words[3] & 4294967295 }
        elif data[260] == 'a' { mode = words[2] & 4294967295 }
        else { return error.UnknownArchitecture }

        result.size = words[6]
        result.seconds = words[11]
        result.nanos = words[12]
    }

    if (mode & 61440) != 32768 || result.size < 0 { return error.NotRegularFile }

    return result
}

/// hashes a file while checking that it remains stable during the read.
@pub
make fingerprint (path: str) -> str {
    if has_zero(path.pin) { return "" }

    @unsafe {
        make fd = std::os::platform::open(path.data, 0)

        if fd < 0 { return "" }

        make before = stat_file(fd) catch { std::os::platform::close(fd) return "" }
        make hash = Hash.init()
        make buffer: str = ""
        buffer.reserve(32768) catch { std::os::platform::close(fd) return "" }
        make data = buffer.data

        while true {
            make count = std::os::platform::read(fd, data, 32768)

            if count < 0 {
                if errno_value() == 4 { continue }

                std::os::platform::close(fd) return ""
            }

            if count == 0 { break }

            hash.add(data, count)
        }

        make after = stat_file(fd) catch { std::os::platform::close(fd) return "" }

        std::os::platform::close(fd)

        if before.size != after.size || before.seconds != after.seconds || before.nanos != after.nanos { return "" }

        return "size=" + after.size.to_str() + " hash=" + hash.format()
    }
}
/// returns a digest of the supplied content.
@pub
make digest (content: str) -> str {
    make hash = Hash.init()
    @unsafe hash.add(content.data, content.len())
    return hash.format()
}

@unsafe
make from_cstr (data: ptr<char>) -> str {
    make result: str = ""
    make i: uint = 0

    while data[i] != '\0' { result.push(data[i]) i = i + 1 }

    return result
}

/// finds the path of the currently running compiler executable.
@pub
make executable () -> str {
    @unsafe {
        make buffer: str = ""
        buffer.reserve(4096) catch { return "" }
        make data = buffer.data

        @target "macos" {
            make size: u32 = 4096

            if std::os::platform::_NSGetExecutablePath(data, size.pin) != 0 { return "" }
        }

        @target "linux" {
            make count = std::os::platform::readlink("/proc/self/exe".data, data, 4095)

            if count < 0 || count >= 4095 { return "" }

            data[count] = '\0'
        }

        make resolved: str = ""
        resolved.reserve(4096) catch { return "" }
        @unsafe make null: ptr<char> = 0

        if std::os::platform::realpath(data, resolved.data) == null { return "" }

        return from_cstr(resolved.data)
    }
}
