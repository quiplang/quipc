@pure @const {
make util = @import "../util/pkg.quip"
}

/// maps source offsets to line and column locations.
@pub
make type LineMap {

    make offsets: uint[] // offsets[i] = start index of line i+1
    make size: uint = 0  // total length of the content

    @pub
    make init (content: ref<str>) -> LineMap {

        make map = LineMap {}

        map.offsets = []
        map.offsets.push(0)

        make index: uint = 0

        while index < content.*.len() {

            if content.*[index] == '\n' {
                map.offsets.push(index + 1)
            }

            index = index + 1
        }

        map.size = index

        return map
    }

    /// emits a line of the count.
    @pub @this
    make line_count () -> uint {
        make n: uint = this.offsets.len()

        return n
    }

    // byte offset where `line` (1-based) starts
    @pub @this
    make line_start (line: uint) -> uint {
        if line == 0 || line > this.offsets.len() {
            return this.size
        }

        make start: uint = this.offsets[line - 1]

        return start
    }

    // byte offset where `line` (1-based) ends, excluding the newline
    @pub @this
    make line_end (line: uint) -> uint {
        if line == 0 || line >= this.offsets.len() {
            return this.size
        }

        make end: uint = this.offsets[line] - 1

        return end
    }

    /// finds the location containing a source offset.
    @pub @this
    make resolve (offset: uint) -> util::Location {
        make loc = util::Location { line = 0, col = 0 }

        // binary search
        make low: uint = 0
        make high: uint = this.offsets.len() - 1
        make found: uint = 0

        while low <= high {
            make mid: uint = low + (high - low) / 2

            if this.offsets[mid] <= offset {
                found = mid
                low = mid + 1
            } else {
                if mid == 0 { break } // underflow

                high = mid - 1
            }
        }

        loc.line = found + 1
        loc.col = (offset - this.offsets[found]) + 1

        return loc
    }
}
