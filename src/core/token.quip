@pure @const {
make std = @import "std"
make util = @import "../util/pkg.quip"
}

make is_hex_digit (c: char) -> bool {
    return c.is_digit()
        || (c >= 'a' && c <= 'f')
        || (c >= 'A' && c <= 'F')
}

/// identifies a lexical token recognized by the tokenizer.
@pub
make enum TokenKind {
    KeyMake,
    KeyType,
    KeyEnum,

    KeyIf,
    KeyElif,
    KeyElse,
    KeyFor,
    KeyWhile,
    KeyMatch,

    KeyCatch,
    KeyReturn,

    KeyError,

    KeyTrue,
    KeyFalse,
    KeyNone,

    Identifier,
    LiteralNum,
    LiteralString,
    LiteralChar,

    Plus,               // +
    Minus,              // -
    Equal,              // =
    Slash,              // /
    Less,               // <
    Greater,            // >
    Not,                // !
    Question,           // ?
    Asterisk,           // *
    Percent,            // %
    Dot,                // .
    Comma,              // ,
    Semicolon,          // ;
    Colon,              // :
    DoubleColon,        // ::
    Arrow,              // ->
    FatArrow,           // =>
    At,                 // @

    PlusPlus,           // ++
    MinusMinus,         // --
    PercentEqual,       // %=

    PlusEqual,          // +=
    MinusEqual,         // -=
    EqualEqual,         // ==
    LessEqual,          // <=
    GreaterEqual,       // >=
    NotEqual,           // !=
    AsteriskEqual,      // *=
    SlashEqual,         // /=

    LParen,             // (
    RParen,             // )
    LBrace,             // {
    RBrace,             // }
    LBracket,           // [
    RBracket,           // ]

    Ampersand,          // &
    DoubleAmpersand,    // &&
    AmpersandEqual,     // &=
    Pipe,               // |
    DoublePipe,         // ||
    PipeEqual,          // |=
    Caret,              // ^
    CaretEqual,         // ^=
    ShiftLeft,          // <<
    ShiftLeftEqual,     // <<=
    ShiftRight,         // >>
    ShiftRightEqual,    // >>=
    Tilde,              // ~

    EOF,                // end of file
    None,
}

/// stores a token kind, its source text, and its span.
@pub
make type Token {

    @pub {
        make kind: TokenKind = TokenKind.None
        make lexeme: str = ""
        make span: util::Span = .{}
    }

    @pub
    make init () -> Token {
        make token = Token {}

        return token
    }

    @pub
    make create (lexeme: str, span: util::Span, kind: TokenKind) -> Token {
        make token = Token {
            kind = kind,
            lexeme = lexeme,
            span = span,
        }

        return token
    }

    /// prints this token for debugging.
    @pub @this
    make show () -> void {
        if this.kind == TokenKind.None {
            std::io::println("unable to display token")
            return
        }

        std::io::println("=== Token ===")
        std::io::println(this.lexeme)
        print_kind(this.kind)

    }

    @pub @this
    make is_assign_op () -> bool {
        make k = this.kind

        return (k == TokenKind.Equal || k == TokenKind.PlusEqual || k == TokenKind.MinusEqual
            || k == TokenKind.AsteriskEqual || k == TokenKind.SlashEqual || k == TokenKind.PercentEqual
            || k == TokenKind.AmpersandEqual || k == TokenKind.PipeEqual
            || k == TokenKind.CaretEqual || k == TokenKind.ShiftLeftEqual || k == TokenKind.ShiftRightEqual)
    }

    @pub @this
    make copy () -> Token {
        make cp = Token {}

        cp.kind = this.kind
        cp.lexeme = this.lexeme !
        cp.span = this.span !

        return cp
    }
}


make enum LexerState {
    Normal,
    Identifier,
    NumberLit,
    StringLit,
    CharLit,
    Slash,
    Operator,
}

/// tokenizes source text into a token array.
@pub
make tokenize (content: str) -> !Token[] {
    make offset: uint = 0

    return tokenize_at(content, offset.pin)
}

/// tokenizes source text and records the offset of a lexical failure.
@pub
make tokenize_at (content: str, failure_offset: ref<uint>) -> !Token[] {
    make tokens: Token[] = []
    make pos: uint = 0
    make span_start: uint = 0
    make state = LexerState.Normal

    // the single-quote code point cannot be written as a `'\''` literal here: the seed
    // compiler used to build this file stops a char literal at the first unescaped `'`,
    // so `'\''` would be mis-compiled to `\`. derive it from a one-character string instead
    make quote_src: str = "'"
    make quote: char = quote_src[0]

    while pos < content.len() {
        span_start = pos !

        match state {
            LexerState.Normal {
                if content[pos].is_space() {
                    pos = pos + 1
                } elif content[pos].is_alpha() || content[pos] == '_' {
                    state = LexerState.Identifier
                } elif content[pos].is_digit() {
                    state = LexerState.NumberLit
                } elif content[pos] == '"' {
                    state = LexerState.StringLit
                } elif content[pos] == quote {
                    state = LexerState.CharLit
                } elif content[pos] == '/' {
                    state = LexerState.Slash
                } else {
                    state = LexerState.Operator
                }
            }

            LexerState.Identifier {
                make buffer: str = ""
                make buf_idx = 0

                while content[pos].is_alnum() || content[pos] == '_' {
                    if buf_idx < 255 {
                        buffer.push(content[pos])
                        buf_idx = buf_idx + 1
                    } else {
                        failure_offset.* = pos
                        return error.IdentifierTooLong
                    }

                    pos = pos + 1
                }

                make kind = match_booleans(buffer.pin)

                if kind == TokenKind.None {
                    kind = match_keywords(buffer.pin)
                }

                make sp = util::Span { start = span_start, end = pos ! }
                make tk = Token.create(buffer.copy(), sp, kind)
                tokens.push(tk)
                state = LexerState.Normal
            }

            LexerState.NumberLit {
                make buffer: str = ""
                make buf_idx = 0
                make has_dot = false
                make has_hex = false
                make has_bin = false

                if content[pos] == '0' && (content[pos + 1] == 'x' || content[pos + 1] == 'X') {
                    has_hex = true
                    buffer.push(content[pos])
                    pos = pos + 1
                    buf_idx = buf_idx + 1
                    buffer.push(content[pos]) // x
                    pos = pos + 1
                    buf_idx = buf_idx + 1
                } elif content[pos] == '0' && (content[pos + 1] == 'b' || content[pos + 1] == 'B') {
                    has_bin = true
                    buffer.push(content[pos])
                    pos = pos + 1
                    buf_idx = buf_idx + 1
                    buffer.push(content[pos]) // b
                    pos = pos + 1
                    buf_idx = buf_idx + 1
                }

                make scanning = true

                while scanning {
                    make c = content[pos]
                    make accepted = false

                    if has_hex {
                        accepted = is_hex_digit(c) || c == '_'
                    } elif has_bin {
                        accepted = c == '0' || c == '1' || c == '_'
                    } else {
                        accepted = c.is_digit() || c == '_'

                        if c == '.' && !has_dot && pos + 1 < content.len() && content[pos + 1].is_digit() {
                            has_dot = true
                            accepted = true
                        }
                    }

                    if !accepted {
                        scanning = false
                    } else {
                        buffer.push(c)
                        pos = pos + 1
                        buf_idx = buf_idx + 1
                    }
                }

                make sp = util::Span { start = span_start, end = pos ! }
                make tk = Token.create(buffer.copy(), sp, TokenKind.LiteralNum)
                tokens.push(tk)
                state = LexerState.Normal
            }

            LexerState.StringLit {
                make buffer: str = ""
                pos = pos + 1 // skip opening quote

                while pos < content.len() && content[pos] != '\0' {
                    if content[pos] == '\\' {
                        pos = pos + 1 // consume the backslash

                        if pos >= content.len() { failure_offset.* = span_start return error.UnexpectedEndOfFile }

                        make esc = content[pos]

                        if esc == 'n' {
                            buffer.push('\n')
                        } elif esc == 't' {
                            buffer.push('\t')
                        } elif esc == 'r' {
                            buffer.push('\r')
                        } elif esc == '0' {
                            buffer.push('\0')
                        } elif esc == '\\' {
                            buffer.push('\\')
                        } elif esc == '"' {
                            buffer.push('"')
                        } elif esc == quote {
                            buffer.push(quote)
                        } else {
                            buffer.push(esc)
                        }

                        pos = pos + 1
                    } elif content[pos] == '"' {
                        break
                    } else {
                        buffer.push(content[pos])
                        pos = pos + 1
                    }
                }

                if pos >= content.len() || content[pos] != '"' { failure_offset.* = span_start return error.UnexpectedEndOfFile }

                if content[pos] == '"' { // skip closing quote
                    pos = pos + 1
                }

                make sp = util::Span { start = span_start, end = pos ! }
                make tk = Token.create(buffer.copy(), sp, TokenKind.LiteralString)
                tokens.push(tk)
                state = LexerState.Normal
            }

            LexerState.CharLit {
                make buffer: str = ""
                pos = pos + 1 // skip opening quote

                while pos < content.len() && content[pos] != '\0' {
                    if content[pos] == '\\' {
                        pos = pos + 1 // consume the backslash

                        if pos >= content.len() { failure_offset.* = span_start return error.UnexpectedEndOfFile }

                        make esc = content[pos]

                        if esc == 'n' {
                            buffer.push('\n')
                        } elif esc == 't' {
                            buffer.push('\t')
                        } elif esc == 'r' {
                            buffer.push('\r')
                        } elif esc == '0' {
                            buffer.push('\0')
                        } elif esc == '\\' {
                            buffer.push('\\')
                        } elif esc == quote {
                            buffer.push(quote)
                        } else {
                            buffer.push(esc)
                        }

                        pos = pos + 1
                    } elif content[pos] == quote {
                        break
                    } else {
                        buffer.push(content[pos])
                        pos = pos + 1
                    }
                }

                if pos >= content.len() || content[pos] != quote { failure_offset.* = span_start return error.UnexpectedEndOfFile }

                if content[pos] == quote { // skip closing quote
                    pos = pos + 1
                }

                make sp = util::Span { start = span_start, end = pos ! }
                make tk = Token.create(buffer.copy(), sp, TokenKind.LiteralChar)
                tokens.push(tk)
                state = LexerState.Normal
            }

            LexerState.Slash {
                if content[pos + 1] == '/' { // line comment (//)
                    pos = pos + 2

                    while content[pos] != '\n' && content[pos] != '\0' {
                        pos = pos + 1
                    }
                } elif content[pos + 1] == '=' { // slash equal (/=)
                    pos = pos + 2
                    make sp = util::Span { start = span_start, end = pos ! }
                    make tk = Token.create("/=", sp, TokenKind.SlashEqual)
                    tokens.push(tk)
                } else { // division (/)
                    pos = pos + 1
                    make sp = util::Span { start = span_start, end = pos ! }
                    make tk = Token.create("/", sp, TokenKind.Slash)
                    tokens.push(tk)
                }

                state = LexerState.Normal
            }

            LexerState.Operator {
                make t: char = content[pos]
                pos = pos + 1

                match t {
                    '{' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("{", sp, TokenKind.LBrace)
                        tokens.push(tk)
                    }

                    '}' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("}", sp, TokenKind.RBrace)
                        tokens.push(tk)
                    }

                    '[' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("[", sp, TokenKind.LBracket)
                        tokens.push(tk)
                    }

                    ']' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("]", sp, TokenKind.RBracket)
                        tokens.push(tk)
                    }

                    '(' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("(", sp, TokenKind.LParen)
                        tokens.push(tk)
                    }

                    ')' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create(")", sp, TokenKind.RParen)
                        tokens.push(tk)
                    }

                    ';' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create(";", sp, TokenKind.Semicolon)
                        tokens.push(tk)
                    }

                    ',' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create(",", sp, TokenKind.Comma)
                        tokens.push(tk)
                    }

                    '.' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create(".", sp, TokenKind.Dot)
                        tokens.push(tk)
                    }

                    '@' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("@", sp, TokenKind.At)
                        tokens.push(tk)
                    }

                    '%' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }

                            tokens.push(Token.create("%=", sp, TokenKind.PercentEqual))
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("%", sp, TokenKind.Percent)
                            tokens.push(tk)
                        }
                    }

                    '~' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("~", sp, TokenKind.Tilde)
                        tokens.push(tk)
                    }

                    '<' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("<=", sp, TokenKind.LessEqual)
                            tokens.push(tk)
                        } elif content[pos] == '<' {
                            pos = pos + 1

                            if content[pos] == '=' {
                                pos = pos + 1
                                make sp = util::Span { start = span_start, end = pos ! }
                                make tk = Token.create("<<=", sp, TokenKind.ShiftLeftEqual)
                                tokens.push(tk)
                            } else {
                                make sp = util::Span { start = span_start, end = pos ! }
                                make tk = Token.create("<<", sp, TokenKind.ShiftLeft)
                                tokens.push(tk)
                            }
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("<", sp, TokenKind.Less)
                            tokens.push(tk)
                        }
                    }

                    '>' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create(">=", sp, TokenKind.GreaterEqual)
                            tokens.push(tk)
                        } elif content[pos] == '>' {
                            pos = pos + 1

                            if content[pos] == '=' {
                                pos = pos + 1
                                make sp = util::Span { start = span_start, end = pos ! }
                                make tk = Token.create(">>=", sp, TokenKind.ShiftRightEqual)
                                tokens.push(tk)
                            } else {
                                make sp = util::Span { start = span_start, end = pos ! }
                                make tk = Token.create(">>", sp, TokenKind.ShiftRight)
                                tokens.push(tk)
                            }
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create(">", sp, TokenKind.Greater)
                            tokens.push(tk)
                        }
                    }

                    '=' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("==", sp, TokenKind.EqualEqual)
                            tokens.push(tk)
                        } elif content[pos] == '>' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("=>", sp, TokenKind.FatArrow)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("=", sp, TokenKind.Equal)
                            tokens.push(tk)
                        }
                    }

                    '!' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("!=", sp, TokenKind.NotEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("!", sp, TokenKind.Not)
                            tokens.push(tk)
                        }
                    }

                    '?' {
                        make sp = util::Span { start = span_start, end = pos ! }
                        make tk = Token.create("?", sp, TokenKind.Question)
                        tokens.push(tk)
                    }

                    ':' {

                        if content[pos] == ':' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("::", sp, TokenKind.DoubleColon)
                            tokens.push(tk)
                        } else {

                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create(":", sp, TokenKind.Colon)
                            tokens.push(tk)
                        }
                    }

                    '+' {
                        if content[pos] == '+' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }

                            tokens.push(Token.create("++", sp, TokenKind.PlusPlus))
                        } elif content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("+=", sp, TokenKind.PlusEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("+", sp, TokenKind.Plus)
                            tokens.push(tk)
                        }
                    }

                    '*' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("*=", sp, TokenKind.AsteriskEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("*", sp, TokenKind.Asterisk)
                            tokens.push(tk)
                        }
                    }

                    '-' {
                        if content[pos] == '-' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }

                            tokens.push(Token.create("--", sp, TokenKind.MinusMinus))
                        } elif content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("-=", sp, TokenKind.MinusEqual)
                            tokens.push(tk)
                        } elif content[pos] == '>' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("->", sp, TokenKind.Arrow)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("-", sp, TokenKind.Minus)
                            tokens.push(tk)
                        }
                    }

                    '&' {
                        if content[pos] == '&' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("&&", sp, TokenKind.DoubleAmpersand)
                            tokens.push(tk)
                        } elif content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("&=", sp, TokenKind.AmpersandEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("&", sp, TokenKind.Ampersand)
                            tokens.push(tk)
                        }
                    }

                    '|' {
                        if content[pos] == '|' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("||", sp, TokenKind.DoublePipe)
                            tokens.push(tk)
                        } elif content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("|=", sp, TokenKind.PipeEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("|", sp, TokenKind.Pipe)
                            tokens.push(tk)
                        }
                    }

                    '^' {
                        if content[pos] == '=' {
                            pos = pos + 1
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("^=", sp, TokenKind.CaretEqual)
                            tokens.push(tk)
                        } else {
                            make sp = util::Span { start = span_start, end = pos ! }
                            make tk = Token.create("^", sp, TokenKind.Caret)
                            tokens.push(tk)
                        }
                    }

                    _ {
                        failure_offset.* = span_start
                        return error.UnexpectedCharacter
                    }
                }

                state = LexerState.Normal
            }

            _ {
                failure_offset.* = pos
                return error.UnexpectedCharacter
                std::io::println("unexpected character")
                pos = pos + 1 // advance to avoid infinite loop on unexpected char
                state = LexerState.Normal
            }
        }
    }

    make sp = util::Span { start = content.len(), end = content.len() }
    make token = Token.create("EOF", sp, TokenKind.EOF)
    tokens.push(token)

    return tokens
}

/// matches the booleans.
make match_booleans (buffer: ref<str>) -> TokenKind {
    if buffer.* == "true" { return TokenKind.KeyTrue }

    if buffer.* == "false" { return TokenKind.KeyFalse }

    if buffer.* == "none" { return TokenKind.KeyNone }

    return TokenKind.None
}

/// matches the keywords.
make match_keywords (buffer: ref<str>) -> TokenKind {
    if buffer.* == "make" { return TokenKind.KeyMake }

    if buffer.* == "type" { return TokenKind.KeyType }

    if buffer.* == "enum" { return TokenKind.KeyEnum }

    if buffer.* == "if" { return TokenKind.KeyIf }

    if buffer.* == "elif" { return TokenKind.KeyElif }

    if buffer.* == "else" { return TokenKind.KeyElse }

    if buffer.* == "for" { return TokenKind.KeyFor }

    if buffer.* == "while" { return TokenKind.KeyWhile }

    if buffer.* == "match" { return TokenKind.KeyMatch }

    if buffer.* == "catch" { return TokenKind.KeyCatch }

    if buffer.* == "return" { return TokenKind.KeyReturn }

    if buffer.* == "error" { return TokenKind.KeyError }

    return TokenKind.Identifier
}

@pub
make print_kind (kind: TokenKind) {
    match kind {
        TokenKind.None { std::io::println("None") }

        TokenKind.EOF { std::io::println("EOF") }

        TokenKind.Identifier { std::io::println("Identifier") }

        TokenKind.KeyMake { std::io::println("KeyMake") }

        TokenKind.KeyType { std::io::println("KeyType") }

        TokenKind.KeyEnum { std::io::println("KeyEnum") }

        TokenKind.KeyIf { std::io::println("KeyIf") }

        TokenKind.KeyElif { std::io::println("KeyElif") }

        TokenKind.KeyElse { std::io::println("KeyElse") }

        TokenKind.KeyFor { std::io::println("KeyFor") }

        TokenKind.KeyWhile { std::io::println("KeyWhile") }

        TokenKind.KeyMatch { std::io::println("KeyMatch") }

        TokenKind.KeyCatch { std::io::println("KeyCatch") }

        TokenKind.KeyReturn { std::io::println("KeyReturn") }

        TokenKind.KeyTrue { std::io::println("KeyTrue") }

        TokenKind.KeyFalse { std::io::println("KeyFalse") }

        TokenKind.KeyNone { std::io::println("KeyNone") }

        TokenKind.Identifier { std::io::println("Identifier") }

        TokenKind.LiteralNum { std::io::println("LiteralNum") }

        TokenKind.LiteralString { std::io::println("LiteralString") }

        TokenKind.LiteralChar { std::io::println("LiteralChar") }


        TokenKind.Plus { std::io::println("Plus") }

        TokenKind.Minus { std::io::println("Minus") }

        TokenKind.Asterisk { std::io::println("Astersik") }

        TokenKind.Slash { std::io::println("Slash") }

        TokenKind.Percent { std::io::println("Percent") }

        TokenKind.Equal { std::io::println("Equal") }

        TokenKind.Dot { std::io::println("Dot") }

        TokenKind.Comma { std::io::println("Comma") }

        TokenKind.Semicolon { std::io::println("SemiColon") }

        TokenKind.Colon { std::io::println("Colon") }

        TokenKind.DoubleColon { std::io::println("DoubleColon") }

        TokenKind.Arrow { std::io::println("Arrow") }

