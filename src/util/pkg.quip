@pure @const {
    make std = @import "std"
    make um = @import "../core/unit_manager.quip"
}

/// stores the start and end offsets of a source span.
@pub
make type Span {
    @pub {
        make start: uint = 0
        make end: uint = 0
    }

    @pub @this @copy
    make copy () -> Span {
        make c = Span {}

        c.start = this.start !
        c.end = this.end !

        return c
    }
}

/// stores the boundary spans of a source range.
@pub
make type Range {
    @pub {
        make start: Span = .{}
        make end: Span = .{}
    }

    // range covering the byte offsets [start, end)
    @pub
    make of (start: uint, end: uint) -> Range {
        make r = Range {}

        r.start = Span { start = start, end = end }

        r.end = Span { start = start, end = end }

        return r
    }

    @pub @this @copy
    make copy () -> Range {
        make c = Range {}

        c.start = this.start !
        c.end = this.end !

        return c
    }
}

/// associates an identifier name with its source span.
@pub
make type Identifier {
    make name: str
    make span: Span
}

/// stores a resolved source line and column.
@pub
make type Location {
    @pub {
        make line: uint
        make col: uint
    }
}
