@pure @const {
    make ssa = @import "../src/llvm/ssa.quip"
    make mir = @import "../src/mir/mir.quip"
    make flow = @import "../src/mir/flow.quip"
}

@pub @entry
make main () -> int {
    make bits: uint[] = [0, 0]
    flow::insert(bits.pin, 0, 31)
    flow::insert(bits.pin, 0, 32)
    flow::insert(bits.pin, 0, 63)
    flow::insert(bits.pin, 0, 64)
    flow::insert(bits.pin, 0, 127)
    flow::remove(bits.pin, 0, 31)
    if flow::bit(bits.pin, 0, 31) || !flow::bit(bits.pin, 0, 32) || !flow::bit(bits.pin, 0, 63)
        || !flow::bit(bits.pin, 0, 64) || !flow::bit(bits.pin, 0, 127) { return 9 }
    flow::remove(bits.pin, 0, 63)
    if flow::bit(bits.pin, 0, 63) || !flow::bit(bits.pin, 0, 32) { return 10 }
    // A definition on one side of a diamond cannot supply the join.
    make body = mir::MirBody {
        locals = [mir::MirLocal { ty = "int" }, mir::MirLocal { ty = "int" }],
        stmts = [
            mir::MirStmt { block = 1, place = mir::MirPlace { local = 1 } },
            mir::MirStmt { block = 3, place = mir::MirPlace { local = 0 },
                rvalue = mir::MirRvalue { a = mir::MirOperand {
                    kind = mir::MirOperandKind.Copy, place = mir::MirPlace { local = 1 },
                } } },
        ],
        terms = [
            mir::MirTerm { kind = mir::MirTermKind.Branch, target = 1, other = 2 },
            mir::MirTerm { kind = mir::MirTermKind.Goto, target = 3 },
            mir::MirTerm { kind = mir::MirTermKind.Goto, target = 3 },
            mir::MirTerm { kind = mir::MirTermKind.Return },
        ],
    }
    make planned = ssa::plan(body.pin)
    if planned[1] || !planned[0] { return 1 }

    // A dominating definition emitted after a use still requires storage.
    body.stmts[0].block = 2
    body.stmts[1].block = 1
    body.terms[0].kind = mir::MirTermKind.Goto
    body.terms[0].target = 2
    body.terms[2].target = 1
    body.terms[1].kind = mir::MirTermKind.Return
    planned = ssa::plan(body.pin)
    if planned[1] { return 2 }

    // Taking an address prevents promotion even without an explicit read.
    body.stmts[1].rvalue.kind = mir::MirRvalueKind.Pin
    body.stmts[1].rvalue.place.local = 1
    planned = ssa::plan(body.pin)
    if planned[1] { return 3 }

    // Empty chains collapse, while cleanup markers and cycles survive.
    body.stmts = []
    body.terms = [
        mir::MirTerm { kind = mir::MirTermKind.Goto, target = 1 },
        mir::MirTerm { kind = mir::MirTermKind.Goto, target = 2 },
        mir::MirTerm { kind = mir::MirTermKind.Goto, target = 3 },
        mir::MirTerm { kind = mir::MirTermKind.Return },
    ]
    make targets = ssa::targets(body.pin)
    if targets[0] != 0 || targets[1] != 3 || targets[2] != 3 { return 4 }
    body.stmts.push(mir::MirStmt { block = 2, kind = mir::MirStmtKind.StorageDead, local = 1 })
    targets = ssa::targets(body.pin)
    if targets[1] != 2 || targets[2] != 2 { return 5 }
    body.stmts = []
    body.terms[2].target = 1
    targets = ssa::targets(body.pin)
    if targets[1] != 1 || targets[2] != 2 { return 6 }
    if !ssa::entry_is_first(body.pin) { return 7 }
    body.terms[2].target = 0
    if ssa::entry_is_first(body.pin) { return 8 }
    return 0
}
